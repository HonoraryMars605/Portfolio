---
import type { HTMLAttributes } from "astro/types"
import type { BadgeVariant } from "@/types"
import Link from "./Link.astro"

export interface Props extends HTMLAttributes<"span"> {
  variant?: BadgeVariant
  href?: string
}

const { variant = "default", href, class: className, ...rest } = Astro.props
---

{href ? (
    <Link href={href} data-badge data-variant={variant} class={className ?? undefined} {...rest}>
      <slot />
    </Link>
  ) : (
    <span data-badge data-variant={variant} class={className ?? undefined} {...rest}>
      <slot />
    </span>
  )}

<style>
  [data-badge] {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    inline-size: fit-content;
    max-inline-size: 100%;
    flex-shrink: 0;
    padding: 0.125rem 0.5rem;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    font-size: var(--step--1);
    line-height: 1.25;
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition:
      background-color var(--motion-duration) var(--motion-ease),
      border-color var(--motion-duration) var(--motion-ease),
      color var(--motion-duration-fast) var(--motion-ease);
  }

  [data-badge] :global(svg) {
    inline-size: 1em;
    block-size: 1em;
    flex-shrink: 0;
  }

  [data-badge][data-variant="default"] {
    background: var(--primary);
    color: var(--primary-foreground);
  }

  [data-badge][data-variant="accent"] {
    background: var(--accent);
    color: var(--accent-foreground);
  }

  [data-badge][data-variant="destructive"],
  [data-badge][data-variant="danger"] {
    border-color: color-mix(in srgb, var(--destructive) 45%, transparent);
    background: color-mix(in srgb, var(--destructive) 10%, transparent);
    color: var(--destructive);
  }

  [data-badge][data-variant="outline"],
  [data-badge][data-variant="tag"] {
    background: var(--surface);
    border-color: var(--border);
    color: var(--foreground);
  }

  [data-badge][data-variant="muted"] {
    background: var(--accent-soft);
    border-color: color-mix(in srgb, var(--accent) 25%, transparent);
    color: var(--accent);
    font-weight: var(--font-weight-medium);
  }

  [data-badge][data-variant="success"] {
    background: var(--accent-soft);
    border-color: color-mix(in srgb, var(--primary) 35%, transparent);
    color: var(--primary);
  }

  [data-badge][data-variant="warning"] {
    background: color-mix(in srgb, #D85829 12%, transparent);
    border-color: color-mix(in srgb, #D85829 45%, transparent);
    color: var(--primary);
  }

  [data-badge][data-variant="info"] {
    background: var(--accent-soft);
    border-color: color-mix(in srgb, var(--accent) 35%, transparent);
    color: var(--accent);
  }

  a[data-badge]:hover {
    border-color: var(--primary);
    background: var(--primary);
    color: var(--primary-foreground);
  }
</style>
