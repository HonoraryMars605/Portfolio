---
interface ProjectItem {
  id: string
  title: string
  image: string
  href: string
  isExternal?: boolean
}

const projects: ProjectItem[] = [
  {
    id: "portfolio-sito-web",
    title: "Portfolio sito web",
    image: "/assets/figma/proj-portfolio.png",
    href: "https://github.com/valeriocomella/valeriocomella.github.io",
    isExternal: true,
  },
  {
    id: "violinum",
    title: "VIOLINUM - ITALIAN GAME 2025",
    image: "/assets/figma/proj-violinum.png",
    href: "/projects/violinum",
    isExternal: false,
  },
  {
    id: "lock-fight",
    title: "LOCK FIGHT",
    image: "/assets/figma/proj-lockfight.png",
    href: "/projects/lock-fight",
    isExternal: false,
  },
  {
    id: "rusheep",
    title: "Rusheep",
    image: "/assets/figma/proj-rusheep.png",
    href: "/projects/rusheep",
    isExternal: false,
  },
  {
    id: "its-lazio-digital",
    title: "Project works - ITS Lazio Digital",
    image: "/assets/figma/proj-its-lazio.png",
    href: "https://github.com/valeriocomella",
    isExternal: true,
  },
  {
    id: "sfuryatell",
    title: "Sfuryatell - ISAS",
    image: "/assets/figma/proj-sfuryatell.png",
    href: "/projects/sfuryatell",
    isExternal: false,
  },
]
---

<section id="progetti" class="w-full max-w-[1200px] flex flex-col gap-[30px]">
  <!-- Intestazione Sezione -->
  <div class="flex flex-col gap-[8px]">
    <h2 class="font-heading text-2xl sm:text-3xl lg:text-[36px] text-[#9B1C2E] uppercase tracking-wide m-0">
      PROGETTI
    </h2>
    <p class="font-sans text-base sm:text-[18px] text-[#333333] m-0">
      Scopri i miei ultimi progetti a cui ho lavorato o a cui sto lavorando
    </p>
  </div>

  <!-- Griglia Progetti (3 colonne, 2 righe) -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[30px]">
    {
      projects.map((proj) => (
        <a
          href={proj.href}
          target={proj.isExternal ? "_blank" : "_self"}
          rel={proj.isExternal ? "noopener noreferrer" : undefined}
          class="group bg-white rounded-[8px] overflow-hidden flex flex-col no-underline transition-all duration-300 hover:shadow-lg hover:-translate-y-1 border border-transparent hover:border-[#9B1C2E]/20"
        >
          <!-- Anteprima Immagine -->
          <div class="w-full h-[251px] overflow-hidden bg-gray-100 flex items-center justify-center">
            <img
              src={proj.image}
              alt={proj.title}
              width="380"
              height="251"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
          </div>

          <!-- Dettagli Progetto -->
          <div class="p-[24px] pt-[20px] flex flex-col justify-between flex-1 gap-[12px]">
            <h3 class="font-heading text-[21px] text-[#111111] leading-snug line-clamp-2 m-0 group-hover:text-[#9B1C2E] transition-colors">
              {proj.title}
            </h3>
            <span class="font-sans text-[15px] font-bold text-[#9B1C2E] group-hover:translate-x-1 transition-transform inline-flex items-center gap-1 uppercase tracking-wider">
              CLICCAMI! →
            </span>
          </div>
        </a>
      ))
    }
  </div>

  <!-- Pulsante · Vedi tutti i progetti -->
  <div>
    <a
      href="https://github.com/valeriocomella?tab=repositories"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block px-[24px] py-[12px] bg-[#9B1C2E]/[0.06] hover:bg-[#9B1C2E]/[0.12] rounded-[8px] text-[#9B1C2E] font-sans text-[16px] font-medium transition-colors no-underline"
    >
      Vedi tutti i progetti
    </a>
  </div>
</section>
