---

<section id="home" class="w-full max-w-[1200px] bg-white rounded-[8px] p-6 sm:p-10 lg:p-[48px] shadow-[0_12px_30px_rgba(17,17,17,0.10)] flex flex-col lg:flex-row items-center justify-between gap-[30px] transition-all">
  <!-- Testi di presentazione (Left) -->
  <div class="w-full lg:w-[734px] flex flex-col gap-[12px]">
    <!-- Nome -->
    <h1 class="font-heading text-3xl sm:text-4xl lg:text-[48px] text-[#111111] leading-tight m-0">
      Valerio Comella
    </h1>

    <!-- Ruolo -->
    <h2 class="font-heading text-xl sm:text-2xl lg:text-[28px] text-[#9B1C2E] leading-snug whitespace-pre-line m-0">
      Aspirante Game dev
      Web developer in formazione
    </h2>

    <!-- Citazioni Box -->
    <div class="w-full bg-[#9B1C2E]/[0.06] rounded-[8px] p-[16px] flex flex-col gap-[12px] mt-1">
      <p class="font-sans text-base sm:text-[19px] text-[#333333] m-0">
        &rdquo;Building Worlds with Code&rdquo;
      </p>
      <p class="font-sans text-base sm:text-[19px] text-[#333333] m-0">
        &rdquo;IT enthusiast&rdquo;
      </p>
      <p class="font-sans text-base sm:text-[19px] text-[#333333] m-0">
        &rdquo;Code is the new art&rdquo;
      </p>
    </div>
  </div>

  <!-- Illustrazione originale (Right) -->
  <div class="flex-shrink-0 flex items-center justify-center">
    <img
      src="/assets/figma/hero-monitor.png"
      alt="Monitor setup with retro sunset wallpaper"
      width="340"
      height="269"
      class="w-[280px] sm:w-[320px] lg:w-[340px] h-auto rounded-[8px] object-contain transition-transform hover:scale-[1.02]"
      loading="eager"
    />
  </div>
</section>
