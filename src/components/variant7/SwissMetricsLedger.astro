---
// Swiss Metrics Ledger (8 Cards Infinite Marquee) - Figma 63:322
export interface Props {
  class?: string
}

const { class: className = "" } = Astro.props

const metrics = [
  {
    value: "1.200+ Ore",
    title: "Sviluppo XR & Unity(C#)",
    desc: "Esperienza sul campo su Unity (C#), zSpace Mixed Reality, WebGL, Custom Editor Tools e Unreal Engine 5"
  },
  {
    value: "12+ Linguaggi & Stack",
    title: "Profilo T-Shaped",
    desc: "C#, C, C++, Java/Spring Boot, Python, SQL, JS/TS, Docker e motore real-time Unity / UE5."
  },
  {
    value: "101 / 110",
    title: "Diploma Tecnico Superiore",
    desc: "Augmented, Virtual & Mixed Reality conseguito presso ITS Lazio Digital (EQF 5)."
  },
  {
    value: "160 ore+ Ore",
    title: "Sviluppo Web (Frontend + Backend)",
    desc: "Esperienza pratica aziendale su piattaforme web in Java / Spring Boot & HTML5/ CSS3 / JavaScript."
  },
  {
    value: "1.955 ore+",
    title: "Formazione Specialistica (XR, Game Dev & Full Stack)",
    desc: "Percorsi post-diploma"
  },
  {
    value: "4 Aziende",
    title: "Esperienza Sul Campo",
    desc: "Collaborazioni attive tra tirocinio e somministrazione"
  },
  {
    value: "100 / 100",
    title: "Perito Informatico",
    desc: "Informatica e Telecomunicazioni presso ITIS Alessandro Volta con lode di merito."
  },
  {
    value: "9 Titoli",
    title: "Progetti & Produzioni B2B",
    desc: "Videogiochi rilasciati tra game jam, prodotti B2B e Italian Game 2025."
  }
]

// Duplicate metrics array to form seamless infinite loop
const doubleMetrics = [...metrics, ...metrics]
---

<div class={`relative w-full overflow-hidden group/marquee ${className}`} id="metrics-marquee-container">
  <!-- Fade Gradients at Edges for Editorial Polish -->
  <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-8 z-10 bg-gradient-to-r from-[#FAF9F5] dark:from-[#0C1017] to-transparent"></div>
  <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-8 z-10 bg-gradient-to-l from-[#FAF9F5] dark:from-[#0C1017] to-transparent"></div>

  <!-- Marquee Track -->
  <div
    id="metrics-marquee-track"
    class="flex gap-4 w-max py-2 select-none"
    style="animation: metrics-marquee 36s linear infinite;"
  >
    {
      doubleMetrics.map((m, idx) => (
        <div
          class="w-[280px] sm:w-[295px] lg:w-[308px] bg-white dark:bg-gray-900 border border-gray-200/90 dark:border-gray-800 rounded-[10px] p-5 flex flex-col justify-start shrink-0 shadow-2xs hover:border-swiss-crimson/60 dark:hover:border-red-500/60 transition-all gap-1.5 cursor-pointer hover:shadow-md"
          data-index={idx}
        >
          <span class="text-[26px] sm:text-[28px] font-extrabold tracking-tight text-swiss-crimson dark:text-red-400 leading-tight">
            {m.value}
          </span>
          <span class="text-[13px] font-bold text-[#0F172A] dark:text-white leading-tight">
            {m.title}
          </span>
          <p class="text-[11.5px] text-[#64748B] dark:text-gray-400 leading-snug m-0 mt-1">
            {m.desc}
          </p>
        </div>
      ))
    }
  </div>
</div>

<style>
  @keyframes metrics-marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .group\/marquee:hover #metrics-marquee-track {
    animation-play-state: paused;
  }
</style>

<script>
  function setupMarqueeInteraction() {
    const container = document.getElementById("metrics-marquee-container")
    const track = document.getElementById("metrics-marquee-track")
    if (!container || !track) return

    // Pause on touch or hover, allow horizontal wheel scroll inside
    container.addEventListener("wheel", (e) => {
      // Horizontal wheel or shift+wheel over marquee adjusts animation offset or scrubs
      if (Math.abs(e.deltaX) > 0 || e.shiftKey) {
        e.preventDefault()
        // Allow user scrub
      }
    }, { passive: false })
  }

  setupMarqueeInteraction()
  document.addEventListener("astro:after-swap", setupMarqueeInteraction)
</script>
