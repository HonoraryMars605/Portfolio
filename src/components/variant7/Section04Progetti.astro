---
// Section 04: Progetti in Evidenza
import SectionPatternCanvas from "./SectionPatternCanvas.astro"
---

<section
  id="section-04"
  class="section-slide relative w-screen min-w-[100vw] h-full overflow-y-auto px-4 sm:px-8 md:px-12 lg:px-16 flex flex-col justify-start shrink-0 snap-start pt-24 sm:pt-28 pb-8"
>
  <SectionPatternCanvas theme="gamedev" />
  <div class="w-full max-w-[1312px] mx-auto flex flex-col justify-start gap-5 relative z-10">
  <!-- Section Editorial Header (Figma 17:6937 & 17:6936) -->
  <div class="flex flex-col gap-1.5 border-b border-gray-200/80 dark:border-gray-800 pb-3">
    <div class="flex items-center gap-3">
      <div class="inline-flex items-center px-3 py-1 rounded-[6px] bg-[#FDF2F4] dark:bg-[#380A10] border border-[#FECDD3] dark:border-red-900 text-[#8B1E2D] dark:text-red-300 font-bold text-[11px] tracking-wide">
        04 // COSA HO CREATO?
      </div>
      <span class="text-[#94A3B8] dark:text-gray-400 font-medium tracking-wider text-[11px] hidden sm:inline">
        INTERACTIVE PRODUCTIONS &amp; SHIPPED GAMES
      </span>
    </div>
    <h2 class="text-2xl sm:text-[32px] font-bold text-[#0F172A] dark:text-white tracking-[-0.02em] mt-1 m-0">
      Portfolio Opere &amp; Produzioni Videoludiche
    </h2>
    <p class="text-[14px] sm:text-[15px] text-[#64748B] dark:text-gray-300 max-w-4xl m-0 leading-normal">
      Demo-prototipi sviluppati e co-sviluppati durante i mie percorsi di studio.
    </p>
  </div>

  <!-- Row 1: Featured 2 Main Projects (Violinum & Lock Fight) -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <!-- Violinum -->
    <a
      href="/projects/violinum"
      class="group bg-white/90 backdrop-blur-xs border border-gray-200/90 rounded-[10px] overflow-hidden flex flex-col justify-between shadow-2xs hover:border-[#9B1C2E]/60 transition-all no-underline"
    >
      <div class="relative w-full h-[180px] bg-gray-900 overflow-hidden">
        <img
          src="/assets/figma/proj-violinum.png"
          alt="Violinum"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        />
        <div class="absolute top-2.5 left-2.5 bg-black/75 backdrop-blur-xs border border-white/20 text-[#FAF9F5] px-2.5 py-1 rounded-[4px] font-mono text-[10px] font-bold tracking-wider uppercase">
          ITALIAN GAME 2025 SELECTION · VR EXPERIENCE
        </div>
      </div>
      <div class="p-4 flex flex-col gap-2">
        <h3 class="text-[20px] font-bold text-[#0F172A] dark:text-white group-hover:text-[#9B1C2E] transition-colors m-0">
          Violinum
        </h3>
        <p class="text-[12.5px] text-[#4B5563] leading-relaxed m-0">
          Esperienza VR immersiva e narrativa selezionata per Italian Game 2025. Sviluppo interazioni musicali aptiche, audio spaziale e rendering VR ottimizzato in C# per headset standalone.
        </p>
        <div class="flex flex-wrap gap-1.5 pt-2 border-t border-gray-100">
          <span class="px-2 py-0.5 rounded-[4px] bg-red-50 text-red-900 font-mono text-[10.5px] font-semibold">Unity</span>
          <span class="px-2 py-0.5 rounded-[4px] bg-red-50 text-red-900 font-mono text-[10.5px] font-semibold">C#</span>
          <span class="px-2 py-0.5 rounded-[4px] bg-purple-50 text-purple-900 font-mono text-[10.5px]">Virtual Reality</span>
          <span class="px-2 py-0.5 rounded-[4px] bg-gray-100 text-gray-700 font-mono text-[10.5px]">3D Audio</span>
          <span class="px-2 py-0.5 rounded-[4px] bg-amber-50 text-amber-900 font-mono text-[10.5px] font-bold">Italian Game 2025</span>
        </div>
      </div>
    </a>

    <!-- Lock Fight -->
    <a
      href="/projects/lock-fight"
      class="group bg-white/90 backdrop-blur-xs border border-gray-200/90 rounded-[10px] overflow-hidden flex flex-col justify-between shadow-2xs hover:border-[#9B1C2E]/60 transition-all no-underline"
    >
      <div class="relative w-full h-[180px] bg-gray-900 overflow-hidden">
        <img
          src="/assets/figma/proj-lockfight.png"
          alt="Lock Fight"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        />
        <div class="absolute top-2.5 left-2.5 bg-black/75 backdrop-blur-xs border border-white/20 text-[#FAF9F5] px-2.5 py-1 rounded-[4px] font-mono text-[10px] font-bold tracking-wider uppercase">
          TACTICAL STRATEGY GAME · SETTEMBRE - OTTOBRE 2024
        </div>
      </div>
      <div class="p-4 flex flex-col gap-2">
        <h3 class="text-[20px] font-bold text-[#0F172A] dark:text-white group-hover:text-[#9B1C2E] transition-colors m-0">
          Lock Fight
        </h3>
        <p class="text-[12.5px] text-[#4B5563] leading-relaxed m-0">
          Videogioco tattico strategico a turni con gestione dello stato della partita, griglia di movimento e intelligenza artificiale per i comportamenti nemici sviluppato in Unity (C#).
        </p>
        <div class="flex flex-wrap gap-1.5 pt-2 border-t border-gray-100">
          <span class="px-2 py-0.5 rounded-[4px] bg-red-50 text-red-900 font-mono text-[10.5px] font-semibold">Unity</span>
          <span class="px-2 py-0.5 rounded-[4px] bg-red-50 text-red-900 font-mono text-[10.5px] font-semibold">C#</span>
          <span class="px-2 py-0.5 rounded-[4px] bg-blue-50 text-blue-900 font-mono text-[10.5px]">Turn-based Tactics</span>
          <span class="px-2 py-0.5 rounded-[4px] bg-gray-100 text-gray-700 font-mono text-[10.5px]">Grid Movement</span>
          <span class="px-2 py-0.5 rounded-[4px] bg-emerald-50 text-emerald-900 font-mono text-[10.5px]">AI State Machine</span>
        </div>
      </div>
    </a>
  </div>

  <!-- Row 2: 3 Medium Projects (Rusheep, Sfuryatell, Project Works) -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <!-- Rusheep -->
    <a
      href="/projects/rusheep"
      class="group bg-white/90 backdrop-blur-xs border border-gray-200/90 rounded-[10px] overflow-hidden flex flex-col justify-between shadow-2xs hover:border-[#9B1C2E]/60 transition-all no-underline"
    >
      <div class="relative w-full h-[130px] bg-gray-900 overflow-hidden">
        <img
          src="/assets/figma/proj-rusheep.png"
          alt="Rusheep"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        />
        <div class="absolute top-2 left-2 bg-black/75 backdrop-blur-xs border border-white/20 text-[#FAF9F5] px-2 py-0.5 rounded-[3px] font-mono text-[9px] font-bold tracking-wider uppercase">
          2D RUNNER · AGO 2024
        </div>
      </div>
      <div class="p-3.5 flex flex-col gap-1.5">
        <h4 class="font-bold text-[15px] text-[#111111] group-hover:text-[#9B1C2E] transition-colors m-0">
          Rusheep
        </h4>
        <p class="text-[12px] text-[#4B5563] leading-snug m-0 line-clamp-3">
          Endless runner dinamico 2D basato sulla fisica dei corpi rigidi, generazione procedurale degli ostacoli e feedback arcade immediato.
        </p>
        <div class="flex flex-wrap gap-1 pt-1.5 border-t border-gray-100">
          <span class="px-1.5 py-0.5 rounded-[3px] bg-red-50 text-red-900 font-mono text-[10px]">Unity 2D</span>
          <span class="px-1.5 py-0.5 rounded-[3px] bg-gray-100 text-gray-700 font-mono text-[10px]">Physics</span>
          <span class="px-1.5 py-0.5 rounded-[3px] bg-gray-100 text-gray-700 font-mono text-[10px]">Procedural</span>
        </div>
      </div>
    </a>

    <!-- Sfuryatell - ISAS -->
    <a
      href="/projects/sfuryatell"
      class="group bg-white/90 backdrop-blur-xs border border-gray-200/90 rounded-[10px] overflow-hidden flex flex-col justify-between shadow-2xs hover:border-[#9B1C2E]/60 transition-all no-underline"
    >
      <div class="relative w-full h-[130px] bg-gray-900 overflow-hidden">
        <img
          src="/assets/figma/proj-sfuryatell.png"
          alt="Sfuryatell"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        />
        <div class="absolute top-2 left-2 bg-black/75 backdrop-blur-xs border border-white/20 text-[#FAF9F5] px-2 py-0.5 rounded-[3px] font-mono text-[9px] font-bold tracking-wider uppercase">
          ARCADE GAME · 2023
        </div>
      </div>
      <div class="p-3.5 flex flex-col gap-1.5">
        <h4 class="font-bold text-[15px] text-[#111111] group-hover:text-[#9B1C2E] transition-colors m-0">
          Sfuryatell - ISAS
        </h4>
        <p class="text-[12px] text-[#4B5563] leading-snug m-0 line-clamp-3">
          Arcade frenetico sviluppato presso ISAS Videogames Academy. Realizzazione interfaccia avanzata con UI Toolkit e logica di gameplay.
        </p>
        <div class="flex flex-wrap gap-1 pt-1.5 border-t border-gray-100">
          <span class="px-1.5 py-0.5 rounded-[3px] bg-red-50 text-red-900 font-mono text-[10px]">Unity</span>
          <span class="px-1.5 py-0.5 rounded-[3px] bg-blue-50 text-blue-900 font-mono text-[10px]">UI Toolkit</span>
          <span class="px-1.5 py-0.5 rounded-[3px] bg-gray-100 text-gray-700 font-mono text-[10px]">ISAS Academy</span>
        </div>
      </div>
    </a>

    <!-- Project Works - ITS Lazio Digital -->
    <div
      class="bg-white/90 backdrop-blur-xs border border-gray-200/90 rounded-[10px] overflow-hidden flex flex-col justify-between shadow-2xs hover:border-[#9B1C2E]/60 transition-all"
    >
      <div class="relative w-full h-[130px] bg-gray-900 overflow-hidden">
        <img
          src="/assets/figma/proj-its-lazio.png"
          alt="Project Works ITS Lazio"
          class="w-full h-full object-cover"
        />
        <div class="absolute top-2 left-2 bg-black/75 backdrop-blur-xs border border-white/20 text-[#FAF9F5] px-2 py-0.5 rounded-[3px] font-mono text-[9px] font-bold tracking-wider uppercase">
          EXTENDED REALITY · 2024 - 2025
        </div>
      </div>
      <div class="p-3.5 flex flex-col gap-1.5">
        <h4 class="font-bold text-[15px] text-[#111111] m-0">
          Project Works - ITS Lazio
        </h4>
        <p class="text-[12px] text-[#4B5563] leading-snug m-0 line-clamp-3">
          Collezione di moduli applicativi XR, interazioni spaziali multi-target e simulazioni interattive realizzate nel biennio ITS.
        </p>
        <div class="flex flex-wrap gap-1 pt-1.5 border-t border-gray-100">
          <span class="px-1.5 py-0.5 rounded-[3px] bg-purple-50 text-purple-900 font-mono text-[10px]">Mixed Reality</span>
          <span class="px-1.5 py-0.5 rounded-[3px] bg-red-50 text-red-900 font-mono text-[10px]">Unity</span>
          <span class="px-1.5 py-0.5 rounded-[3px] bg-gray-100 text-gray-700 font-mono text-[10px]">OpenXR</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Row 3: Game Jams & Experimental Titles Banner -->
  <div class="bg-white/90 backdrop-blur-xs border border-gray-200/90 rounded-[10px] p-4 flex flex-col md:flex-row items-center gap-4 shadow-2xs hover:border-[#9B1C2E]/40 transition-all">
    <div class="w-full md:w-48 h-24 rounded-[6px] bg-gray-900 overflow-hidden shrink-0 border border-gray-100">
      <img
        src="/assets/figma/proj-portfolio.png"
        alt="Game Jams & Prototipi"
        class="w-full h-full object-cover"
      />
    </div>
    <div class="flex flex-col gap-1.5 flex-1">
      <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-[4px] bg-[#9B1C2E]/10 text-[#9B1C2E] font-mono text-[10px] font-bold tracking-wider uppercase w-fit">
        GAME JAMS &amp; EXPERIMENTAL TITLES
      </div>
      <h4 class="font-bold text-[15px] text-[#111111] m-0">
        Il Rito · Please Open The Door · Portfolio Web
      </h4>
      <p class="text-[12px] text-[#4B5563] leading-snug m-0">
        Produzioni indie e game jam: <strong>Il Rito</strong> (esperimento horror d'atmosfera e audio immersivo), <strong>Please Open The Door</strong> (puzzle game ad enigmi logici) e il sito web portfolio moderno sviluppato con standard web reattivi.
      </p>
      <div class="flex flex-wrap gap-1.5 pt-1">
        <span class="px-2 py-0.5 rounded-[4px] bg-gray-100 text-gray-700 font-mono text-[10.5px]">Il Rito (Horror Atmosphere)</span>
        <span class="px-2 py-0.5 rounded-[4px] bg-gray-100 text-gray-700 font-mono text-[10.5px]">Please Open The Door (Puzzle Game)</span>
        <span class="px-2 py-0.5 rounded-[4px] bg-gray-100 text-gray-700 font-mono text-[10.5px]">Portfolio Sito Web</span>
      </div>
    </div>
  </div>
  </div>
</section>
