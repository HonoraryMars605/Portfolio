          <span class="px-2 py-0.5 rounded-[4px] bg-gray-50 dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-sans text-[11px]">Enterprise</span>
        </div>
      </div>

      <!-- Card 4: Katabasi Studio -->
