---
// Section 03: Esperienze Professionali (Figma media_1795189813569_811a617f.jpg - 1:1 Match)
// 4 Cards in 2x2 grid, identical to Figma reference capture
import SectionPatternCanvas from "./SectionPatternCanvas.astro"

export interface Props {
  class?: string
}

const { class: className = "" } = Astro.props
---

<section
  id="section-03"
  class={`section-slide relative w-screen min-w-[100vw] h-full overflow-y-auto px-4 sm:px-8 md:px-12 lg:px-16 flex flex-col justify-center shrink-0 snap-start pt-20 sm:pt-24 pb-8 min-h-full ${className}`}
>
  <SectionPatternCanvas theme="code" />
  <div class="w-full max-w-[1312px] 2xl:max-w-[1560px] 3xl:max-w-[1850px] 4k:max-w-[2200px] mx-auto my-auto flex flex-col justify-center gap-5 2xl:gap-7 relative z-10">
    <!-- Section Editorial Header -->
    <div class="flex flex-col gap-1.5 pb-2">
      <div class="flex items-center gap-3">
        <div class="inline-flex items-center px-3 py-1 rounded-[6px] 2xl:rounded-[8px] bg-swiss-crimson-light dark:bg-[#380A10] border border-swiss-crimson-border dark:border-red-900 text-swiss-crimson dark:text-red-300 font-bold text-[11px] 2xl:text-[13px] tracking-wide font-mono">
          03 // DOVE HO LAVORATO?
        </div>
      </div>
      <h2 class="text-2xl sm:text-[32px] 2xl:text-[38px] 3xl:text-[44px] font-bold text-[#0F172A] dark:text-white tracking-[-0.02em] mt-1 m-0">
        Esperienze Lavorative &amp; Percorso Professionale
      </h2>
      <p class="text-[14px] sm:text-[15px] 2xl:text-[17px] 3xl:text-[19px] text-[#64748B] dark:text-gray-300 max-w-4xl 2xl:max-w-5xl m-0 leading-normal">
        Le collaborazioni e esperienze professionali fino ad oggi
      </p>
    </div>

    <!-- Experience Cards Grid (2x2 Grid - 4 Cards matching Image 2) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 2xl:gap-6">
      <!-- Card 1: Skill Factory -->
      <div class="bg-white dark:bg-gray-900 border border-gray-200/90 dark:border-gray-800 rounded-[14px] 2xl:rounded-[18px] p-5 2xl:p-6 flex flex-col justify-between gap-3.5 2xl:gap-4 shadow-2xs">
        <div>
          <div class="flex items-start justify-between gap-3 border-b border-gray-100 dark:border-gray-800 pb-3">
            <div class="flex items-center gap-3 2xl:gap-4">
              <div class="w-10 h-10 2xl:w-12 2xl:h-12 rounded-[6px] 2xl:rounded-[8px] bg-black text-white flex items-center justify-center font-bold text-[14px] 2xl:text-[16px] shrink-0">
                <svg class="w-5 h-5 fill-current text-white" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              </div>
              <div>
                <h3 class="font-bold text-[15px] 2xl:text-[17px] text-[#0F172A] dark:text-white m-0">
                  Skill Factory
                </h3>
                <p class="text-[12px] 2xl:text-[13.5px] text-[#64748B] dark:text-gray-400 m-0">
                  Back-end Developer
                </p>
              </div>
            </div>
            <span class="px-2.5 py-0.5 rounded-[4px] border border-gray-200 dark:border-gray-700 font-sans text-[11px] 2xl:text-[12.5px] text-gray-600 dark:text-gray-300 whitespace-nowrap">
              Somministrazione
            </span>
          </div>

          <div class="text-[11.5px] 2xl:text-[13px] font-mono text-[#8B1E2D] dark:text-red-400 mt-2.5 mb-2 flex items-center gap-1.5 font-medium">
            <span>2025 - Luglio 2026</span>
          </div>

          <ul class="text-[12px] 2xl:text-[13.5px] text-[#475569] dark:text-gray-300 space-y-1.5 pl-4 list-disc m-0 leading-relaxed">
            <li>Sviluppo piattaforma web aziendale focalizzato sul Back-end tramite Java / Spring Boot + Thymeleaf.</li>
          </ul>
        </div>

        <div class="flex flex-wrap gap-1.5 pt-2 border-t border-gray-100 dark:border-gray-800">
          <span class="px-2 py-0.5 rounded-[4px] bg-gray-50 dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-sans text-[11px] 2xl:text-[12.5px]">Unity</span>
          <span class="px-2 py-0.5 rounded-[4px] bg-gray-50 dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-sans text-[11px] 2xl:text-[12.5px]">C#</span>
          <span class="px-2 py-0.5 rounded-[4px] bg-gray-50 dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-sans text-[11px] 2xl:text-[12.5px]">Java</span>
          <span class="px-2 py-0.5 rounded-[4px] bg-gray-50 dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-sans text-[11px] 2xl:text-[12.5px]">Spring Boot</span>
          <span class="px-2 py-0.5 rounded-[4px] bg-gray-50 dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-sans text-[11px] 2xl:text-[12.5px]">Thymeleaf</span>
          <span class="px-2 py-0.5 rounded-[4px] bg-gray-50 dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-sans text-[11px] 2xl:text-[12.5px]">Didattica</span>
          <span class="px-2 py-0.5 rounded-[4px] bg-gray-50 dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-sans text-[11px] 2xl:text-[12.5px]">OOP</span>
        </div>
      </div>

      <!-- Card 2: L'ABCD Edutainment -->
      <div class="bg-white dark:bg-gray-900 border border-gray-200/90 dark:border-gray-800 rounded-[14px] 2xl:rounded-[18px] p-5 2xl:p-6 flex flex-col justify-between gap-3.5 2xl:gap-4 shadow-2xs">
        <div>
          <div class="flex items-start justify-between gap-3 border-b border-gray-100 dark:border-gray-800 pb-3">
            <div class="flex items-center gap-3 2xl:gap-4">
              <div class="w-10 h-10 2xl:w-12 2xl:h-12 rounded-[6px] 2xl:rounded-[8px] bg-white dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700 flex items-center justify-center p-1 shrink-0">
                <span class="font-bold text-[14px] text-amber-500">▲E<br/>●C</span>
              </div>
              <div>
                <h3 class="font-bold text-[15px] 2xl:text-[17px] text-[#0F172A] dark:text-white m-0">
                  L'ABCD Edutainment
                </h3>
                <p class="text-[12px] 2xl:text-[13.5px] text-[#64748B] dark:text-gray-400 m-0">
                  Unity (C#) Developer HMI-MR
                </p>
              </div>
            </div>
            <span class="px-2.5 py-0.5 rounded-[4px] border border-gray-200 dark:border-gray-700 font-sans text-[11px] 2xl:text-[12.5px] text-gray-600 dark:text-gray-300 whitespace-nowrap">
              Tirocinio Extracurriculare
            </span>
          </div>

          <div class="text-[11.5px] 2xl:text-[13px] font-mono text-[#8B1E2D] dark:text-red-400 mt-2.5 mb-2 flex items-center gap-1.5 font-medium">
            <span>2024 - 2025 (Gennaio - Aprile 2026)</span>
          </div>

          <ul class="text-[12px] 2xl:text-[13.5px] text-[#475569] dark:text-gray-300 space-y-1.5 pl-4 list-disc m-0 leading-relaxed">
            <li>Sviluppatore Unity/C#</li>
            <li>Co-sviluppato diversi applicativi a tema didattico in campo MR e MR-HMI, con l'utilizzo del software e hardware zSpace</li>
            <li>Ricerca e sviluppo in C#, UI design (Figma) e Management (Miro)</li>
          </ul>
        </div>

        <div class="flex flex-wrap gap-1.5 pt-2 border-t border-gray-100 dark:border-gray-800">
          <span class="px-2 py-0.5 rounded-[4px] bg-gray-50 dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-sans text-[11px] 2xl:text-[12.5px]">Mixed Reality</span>
          <span class="px-2 py-0.5 rounded-[4px] bg-gray-50 dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-sans text-[11px] 2xl:text-[12.5px]">zSpace</span>
          <span class="px-2 py-0.5 rounded-[4px] bg-gray-50 dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-sans text-[11px] 2xl:text-[12.5px]">Multi SDK</span>
          <span class="px-2 py-0.5 rounded-[4px] bg-gray-50 dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-sans text-[11px] 2xl:text-[12.5px]">C#</span>
          <span class="px-2 py-0.5 rounded-[4px] bg-gray-50 dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-sans text-[11px] 2xl:text-[12.5px]">uGUI</span>
          <span class="px-2 py-0.5 rounded-[4px] bg-gray-50 dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-sans text-[11px] 2xl:text-[12.5px]">MR-HMI</span>
          <span class="px-2 py-0.5 rounded-[4px] bg-gray-50 dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-sans text-[11px] 2xl:text-[12.5px]">R&amp;D</span>
        </div>
      </div>

      <!-- Card 3: Protom Group -->
      <div class="bg-white dark:bg-gray-900 border border-gray-200/90 dark:border-gray-800 rounded-[14px] 2xl:rounded-[18px] p-5 2xl:p-6 flex flex-col justify-between gap-3.5 2xl:gap-4 shadow-2xs">
        <div>
          <div class="flex items-start justify-between gap-3 border-b border-gray-100 dark:border-gray-800 pb-3">
            <div class="flex items-center gap-3 2xl:gap-4">
              <div class="w-10 h-10 2xl:w-12 2xl:h-12 rounded-[6px] 2xl:rounded-[8px] bg-white dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700 flex items-center justify-center p-1 shrink-0">
                <img src="/assets/variant7/17_6880_Icona___Protom_Group.svg" alt="Protom Group" class="w-full h-full object-contain" />
              </div>
              <div>
                <h3 class="font-bold text-[15px] 2xl:text-[17px] text-[#0F172A] dark:text-white m-0">
                  Protom Group
                </h3>
                <p class="text-[12px] 2xl:text-[13.5px] text-[#64748B] dark:text-gray-400 m-0">
                  Front-end Developer
                </p>
              </div>
            </div>
            <span class="px-2.5 py-0.5 rounded-[4px] border border-gray-200 dark:border-gray-700 font-sans text-[11px] 2xl:text-[12.5px] text-gray-600 dark:text-gray-300 whitespace-nowrap">
              Somministrazione
            </span>
          </div>

          <div class="text-[11.5px] 2xl:text-[13px] font-mono text-[#8B1E2D] dark:text-red-400 mt-2.5 mb-2 flex items-center gap-1.5 font-medium">
            <span>2023 - 2024 (Novembre 2025)</span>
          </div>

          <ul class="text-[12px] 2xl:text-[13.5px] text-[#475569] dark:text-gray-300 space-y-1.5 pl-4 list-disc m-0 leading-relaxed">
            <li>Co-sviluppo piattaforma web focalizzato sul Front-end tramite HTML5, CSS3 e JavaScript.</li>
          </ul>
        </div>

        <div class="flex flex-wrap gap-1.5 pt-2 border-t border-gray-100 dark:border-gray-800">
          <span class="px-2 py-0.5 rounded-[4px] bg-gray-50 dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-sans text-[11px] 2xl:text-[12.5px]">Front-end</span>
          <span class="px-2 py-0.5 rounded-[4px] bg-gray-50 dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-sans text-[11px] 2xl:text-[12.5px]">HTML5</span>
          <span class="px-2 py-0.5 rounded-[4px] bg-gray-50 dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-sans text-[11px] 2xl:text-[12.5px]">CSS3</span>
          <span class="px-2 py-0.5 rounded-[4px] bg-gray-50 dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-sans text-[11px] 2xl:text-[12.5px]">JavaScript</span>
          <span class="px-2 py-0.5 rounded-[4px] bg-gray-50 dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-sans text-[11px] 2xl:text-[12.5px]">Unity XR</span>
          <span class="px-2 py-0.5 rounded-[4px] bg-gray-50 dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-sans text-[11px] 2xl:text-[12.5px]">Enterprise</span>
        </div>
      </div>

      <!-- Card 4: Katabasi Studio -->
      <div class="bg-white dark:bg-gray-900 border border-gray-200/90 dark:border-gray-800 rounded-[14px] 2xl:rounded-[18px] p-5 2xl:p-6 flex flex-col justify-between gap-3.5 2xl:gap-4 shadow-2xs">
        <div>
          <div class="flex items-start justify-between gap-3 border-b border-gray-100 dark:border-gray-800 pb-3">
            <div class="flex items-center gap-3 2xl:gap-4">
              <div class="w-10 h-10 2xl:w-12 2xl:h-12 rounded-[6px] 2xl:rounded-[8px] bg-black border border-gray-800 flex items-center justify-center p-1 shrink-0">
                <img src="/assets/variant7/17_6908_Icona___Katabasi_Studio.svg" alt="Katabasi Studio" class="w-full h-full object-contain" />
              </div>
              <div>
                <h3 class="font-bold text-[15px] 2xl:text-[17px] text-[#0F172A] dark:text-white m-0">
                  Katabasi Studio
                </h3>
                <p class="text-[12px] 2xl:text-[13.5px] text-[#64748B] dark:text-gray-400 m-0">
                  Unity (C#) Developer WebGL
                </p>
              </div>
            </div>
            <span class="px-2.5 py-0.5 rounded-[4px] border border-gray-200 dark:border-gray-700 font-sans text-[11px] 2xl:text-[12.5px] text-gray-600 dark:text-gray-300 whitespace-nowrap">
              Tirocinio Curriculare
            </span>
          </div>

          <div class="text-[11.5px] 2xl:text-[13px] font-mono text-[#8B1E2D] dark:text-red-400 mt-2.5 mb-2 flex items-center gap-1.5 font-medium">
            <span>Nov 2024 - Apr 2025</span>
          </div>

          <ul class="text-[12px] 2xl:text-[13.5px] text-[#475569] dark:text-gray-300 space-y-1.5 pl-4 list-disc m-0 leading-relaxed">
            <li>Sviluppo di due prodotti B2B realizzati con Unity e implementati su piattaforma WebGL.</li>
            <li>Sviluppo in C#, integrati elementi UI (uGUI), organizzazione e documentazione tramite Milanote e Notion</li>
            <li>Gestione della localizzazione e Custom Editor Tools per l'ottimizzazione del workflow di sviluppo.</li>
          </ul>
        </div>

        <div class="flex flex-wrap gap-1.5 pt-2 border-t border-gray-100 dark:border-gray-800">
          <span class="px-2 py-0.5 rounded-[4px] bg-gray-50 dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-sans text-[11px] 2xl:text-[12.5px]">Unity</span>
          <span class="px-2 py-0.5 rounded-[4px] bg-gray-50 dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-sans text-[11px] 2xl:text-[12.5px]">C#</span>
          <span class="px-2 py-0.5 rounded-[4px] bg-gray-50 dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-sans text-[11px] 2xl:text-[12.5px]">WebGL</span>
          <span class="px-2 py-0.5 rounded-[4px] bg-gray-50 dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-sans text-[11px] 2xl:text-[12.5px]">B2B Solutions</span>
          <span class="px-2 py-0.5 rounded-[4px] bg-gray-50 dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-sans text-[11px] 2xl:text-[12.5px]">Custom Editor Tools</span>
          <span class="px-2 py-0.5 rounded-[4px] bg-gray-50 dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-sans text-[11px] 2xl:text-[12.5px]">Localization</span>
          <span class="px-2 py-0.5 rounded-[4px] bg-gray-50 dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-sans text-[11px] 2xl:text-[12.5px]">720+ Ore</span>
        </div>
      </div>
    </div>
  </div>
</section>
