---
// Top Editorial Floating Navigation Bar (Figma Variant 7 Swiss 34:2795)
---

<header class="fixed top-5 inset-x-0 mx-auto max-w-[1400px] w-[calc(100%-32px)] sm:w-[calc(100%-48px)] h-[56px] bg-[#F9FAFB]/95 dark:bg-[#111827]/95 backdrop-blur-md border border-[#E5E7EB] dark:border-gray-800 rounded-[16px] z-40 px-4 sm:px-8 flex items-center justify-between shadow-sm transition-colors duration-200">
  <!-- Marchio / Monogramma VC (Figma 83:1116) -->
  <div class="flex items-center">
    <a href="#section-01" class="flex items-center no-underline" title="Torna a 01 // CHI SONO?">
      <div class="w-[31px] h-[32px] rounded-[6px] bg-[#8B1E2D] flex items-center justify-center text-white font-sans font-bold text-[13px] tracking-tight shadow-xs hover:scale-105 transition-transform">
        VC
      </div>
    </a>
  </div>

  <!-- Navigazione / Preferenze e collegamenti (Figma 38:3784) -->
  <div class="flex items-center gap-1.5 sm:gap-2">
    <!-- Preferenze / Audio (Figma 37:3161) -->
    <button
      id="btn-sound-toggle"
      type="button"
      class="h-[32px] px-2.5 rounded-[6px] border border-[#E5E7EB] dark:border-gray-700 bg-[#F9FAFB] dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-700 text-[11px] font-sans font-bold text-[#374151] dark:text-gray-200 transition-all cursor-pointer flex items-center gap-1.5 shadow-2xs active:scale-95"
      title="Attiva/Disattiva effetti sonori interattivi"
    >
      <span id="sound-toggle-icon">🔊</span>
      <span id="sound-toggle-label" class="hidden sm:inline">SFX ON</span>
    </button>

    <!-- Preferenze / Tema (Figma 37:3164) -->
    <button
      id="btn-theme-toggle"
      type="button"
      class="h-[32px] px-2.5 rounded-[6px] border border-[#E5E7EB] dark:border-gray-700 bg-[#F9FAFB] dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-700 text-[11px] font-sans font-bold text-[#374151] dark:text-gray-200 transition-all cursor-pointer flex items-center gap-1.5 shadow-2xs active:scale-95"
      title="Passa da modalità Chiara a Scura"
    >
      <span id="theme-toggle-icon">🌓</span>
      <span id="theme-toggle-label" class="hidden sm:inline">Dark/Light</span>
    </button>

    <!-- Preferenze / Lingua (Figma 34:2819) -->
    <button
      id="btn-lang-toggle"
      type="button"
      class="h-[32px] px-2.5 rounded-[6px] border border-[#E5E7EB] dark:border-gray-700 bg-[#F9FAFB] dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-700 text-[11px] font-sans font-bold text-[#374151] dark:text-gray-200 transition-all cursor-pointer flex items-center gap-1.5 shadow-2xs active:scale-95"
      title="Cambia lingua / Switch language"
    >
      <span id="lang-toggle-icon">🌐</span>
      <span id="lang-toggle-label">ITA/EN</span>
    </button>

    <!-- Collegamento / CV (Figma 34:2806 & 34:2808) -->
    <button
      type="button"
      id="btn-nav-view-pdf"
      class="btn-view-pdf h-[32px] px-3.5 rounded-full bg-[#8B1E2D] hover:bg-[#6e1622] active:scale-95 text-white font-sans text-[11px] font-bold tracking-wide transition-all shadow-2xs border-none cursor-pointer flex items-center justify-center whitespace-nowrap"
      title="Visualizza Curriculum Vitae (PDF)"
    >
      CV
    </button>

    <!-- Collegamento / LinkedIn (Figma 65:795 & 65:797) -->
    <a
      href="https://www.linkedin.com/in/valerio-comella-6a5693241/"
      target="_blank"
      rel="noopener noreferrer"
      class="h-[32px] px-3.5 rounded-full bg-[#8B1E2D] hover:bg-[#6e1622] active:scale-95 text-white font-sans text-[11px] font-bold tracking-wide transition-all shadow-2xs no-underline flex items-center justify-center whitespace-nowrap"
      title="Profilo LinkedIn ufficiale"
    >
      Linkedin
    </a>

    <!-- Collegamento / GitHub (Figma 65:787 & 65:789) -->
    <a
      href="https://github.com/valeriocomella"
      target="_blank"
      rel="noopener noreferrer"
      class="h-[32px] px-3.5 rounded-full bg-[#8B1E2D] hover:bg-[#6e1622] active:scale-95 text-white font-sans text-[11px] font-bold tracking-wide transition-all shadow-2xs no-underline flex items-center justify-center whitespace-nowrap"
      title="Profilo GitHub ufficiale"
    >
      GitHub
    </a>
  </div>
</header>

<script>
  function setupNavbar() {
    // 1. Sound Button Toggle
    const soundBtn = document.getElementById("btn-sound-toggle")
    const soundIcon = document.getElementById("sound-toggle-icon")
    const soundLabel = document.getElementById("sound-toggle-label")

    if (soundBtn) {
      soundBtn.onclick = () => {
        if ((window as any).soundEngine) {
          const isMuted = (window as any).soundEngine.toggleMute()
          if (soundIcon) soundIcon.textContent = isMuted ? "🔇" : "🔊"
          if (soundLabel) soundLabel.textContent = isMuted ? "SFX OFF" : "SFX ON"
        }
      }
    }

    // 2. Dark/Light Theme Toggle
    const themeBtn = document.getElementById("btn-theme-toggle")
    const themeIcon = document.getElementById("theme-toggle-icon")
    const root = document.documentElement

    const savedTheme = localStorage.getItem("theme")
    if (savedTheme === "dark") {
      root.classList.add("dark")
      if (themeIcon) themeIcon.textContent = "🌙"
    } else {
      root.classList.remove("dark")
      if (themeIcon) themeIcon.textContent = "☀️"
    }

    if (themeBtn) {
      themeBtn.onclick = () => {
        const isDark = root.classList.toggle("dark")
        localStorage.setItem("theme", isDark ? "dark" : "light")
        if (themeIcon) themeIcon.textContent = isDark ? "🌙" : "☀️"
        if ((window as any).playSfx) (window as any).playSfx("click")
      }
    }

    // 3. Language Toggle (ITA / EN)
    const langBtn = document.getElementById("btn-lang-toggle")
    const langLabel = document.getElementById("lang-toggle-label")

    let currentLang = localStorage.getItem("lang") || "it"
    function updateLang(lang: string) {
      currentLang = lang
      localStorage.setItem("lang", lang)
      root.setAttribute("data-lang", lang)
      if (langLabel) langLabel.textContent = lang === "it" ? "ITA" : "ENG"

      // Update text nodes with data-i18n attributes
      const statusText = document.querySelector("[data-i18n-status]")
      if (statusText) {
        statusText.textContent = lang === "it" ? "DISPONIBILE SUBITO" : "AVAILABLE FOR HIRE"
      }
      const pdfText = document.querySelector("[data-i18n-pdf-label]")
      if (pdfText) {
        pdfText.textContent = lang === "it" ? "Visualizza PDF" : "View PDF"
      }

      window.dispatchEvent(new CustomEvent("lang-change", { detail: { lang } }))
    }

    updateLang(currentLang)

    if (langBtn) {
      langBtn.onclick = () => {
        const next = currentLang === "it" ? "en" : "it"
        updateLang(next)
        if ((window as any).playSfx) (window as any).playSfx("click")
      }
    }

    // 4. Nav jump buttons to horizontal scroll sections
    const jumpBtns = document.querySelectorAll(".nav-jump-btn")
    jumpBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = (btn as HTMLElement).dataset.navTarget
        const sec = document.getElementById(`section-${target}`)
        if (sec) {
          sec.scrollIntoView({ behavior: "smooth", inline: "start" })
          if ((window as any).playSfx) (window as any).playSfx("slide")
        }
      })
    })
  }

  setupNavbar()
  document.addEventListener("astro:after-swap", setupNavbar)
</script>
