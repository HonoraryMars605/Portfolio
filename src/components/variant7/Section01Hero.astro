---
import SectionPatternCanvas from "./SectionPatternCanvas.astro"
import SwissMetricsLedger from "./SwissMetricsLedger.astro"
---

<section
  id="section-01"
  class="section-slide relative w-screen min-w-[100vw] h-full overflow-y-auto px-4 sm:px-8 md:px-12 lg:px-16 flex flex-col justify-start shrink-0 snap-start pt-24 sm:pt-28 pb-8"
>
  <SectionPatternCanvas theme="minimal" />
  <div class="w-full max-w-[1312px] mx-auto flex flex-col justify-start gap-6 sm:gap-7 relative z-10">
    <!-- Intestazione / Riga sezione (Figma 17:6664) -->
    <div class="flex items-center gap-3 border-b border-gray-200/80 dark:border-gray-800 pb-3 text-[11px] font-sans">
      <div class="inline-flex items-center px-3 py-1 rounded-[6px] bg-[#FDF2F4] dark:bg-[#380A10] border border-[#FECDD3] dark:border-red-900 text-[#8B1E2D] dark:text-red-300 font-bold tracking-wide">
        01 // CHI SONO?
      </div>
      <span class="text-[#94A3B8] dark:text-gray-400 font-medium tracking-wider text-[11px] hidden sm:inline">
        PORTFOLIO · VARIANT 7 · SWISS EDITORIAL CV
      </span>
    </div>

    <!-- Presentazione / Contenuto e immagine (Figma 83:257) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <!-- Presentazione / Profilo (Left 7 cols) -->
      <div class="lg:col-span-7 flex flex-col gap-4">
        <!-- Presentazione / Nome e ruolo -->
        <div class="flex flex-col gap-2">
          <h1 class="text-4xl sm:text-5xl lg:text-[52px] leading-[56px] text-[#0F172A] dark:text-white tracking-[-0.02em] m-0 font-heading">
            VALERIO COMELLA
          </h1>
          <h2 class="text-lg sm:text-[20px] font-semibold text-[#8B1E2D] dark:text-red-400 tracking-[-0.005em] m-0">
            SOFTWARE ENGINEER | UNITY (C#) &amp; FULL STACK DEVELOPER
          </h2>
        </div>

        <!-- Biografia -->
        <p class="text-[14px] sm:text-[15px] leading-[24px] text-[#334155] dark:text-gray-300 m-0 max-w-xl">
          Unity Developer specializzato in <strong class="text-[#0F172A] dark:text-white font-semibold">C#</strong>, con esperienza nello sviluppo di <strong class="text-[#0F172A] dark:text-white font-semibold">applicazioni interattive</strong>, soluzioni Mixed Reality e prodotti B2B. Solida formazione in <strong class="text-[#0F172A] dark:text-white font-semibold">Game Development e Mixed Reality (ITS EQF5)</strong>, con competenze Full Stack.
        </p>
      </div>

      <!-- Immagine / Presentazione (Right 5 cols) -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end items-center">
        <img
          src="/assets/variant7/hero-monitor-stand.png"
          alt="Valerio Comella - Setup Monitor"
          class="w-full max-w-[380px] sm:max-w-[420px] lg:max-w-[460px] object-contain drop-shadow-md select-none"
          loading="eager"
        />
      </div>
    </div>

    <!-- Metriche / Griglia riepilogativa (Figma 63:322 - 8 Cards Swiss Metrics Ledger) -->
    <div class="pt-2">
      <SwissMetricsLedger />
    </div>
  </div>
</section>
