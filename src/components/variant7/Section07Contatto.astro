---
// Section 07: Contatti e crediti (Figma 65:614)
import RunnerAnteprimaDinamica from "./RunnerAnteprimaDinamica.astro"
import { PROFILE } from "@site-config"

const githubUrl = typeof PROFILE.links.github === "object" ? PROFILE.links.github?.href : PROFILE.links.github || "https://github.com/valeriocomella"
const linkedinUrl = typeof PROFILE.links.linkedin === "object" ? PROFILE.links.linkedin?.href : PROFILE.links.linkedin || "https://www.linkedin.com/in/valerio-comella-6a5693241/"
---

<section
  id="section-07"
  class="section-slide w-screen min-w-[100vw] h-full overflow-y-auto px-4 sm:px-8 md:px-12 lg:px-16 flex flex-col justify-start shrink-0 snap-start pt-24 sm:pt-28 pb-8"
>
  <div class="w-full max-w-[1312px] mx-auto flex flex-col justify-start gap-6 sm:gap-7">
    <!-- Badge sezione / 07 // RIMANIAMO IN CONTATTO? (Figma 65:616 & 65:615) -->
    <div class="flex flex-col gap-1.5 border-b border-gray-200/80 dark:border-gray-800 pb-3">
      <div class="flex items-center gap-3">
        <div class="inline-flex items-center px-3 py-1 rounded-[6px] bg-[#FDF2F4] dark:bg-[#380A10] border border-[#FECDD3] dark:border-red-900 text-[#8B1E2D] dark:text-red-300 font-bold text-[11px] tracking-wide">
          07 // RIMANIAMO IN CONTATTO?
        </div>
        <span class="text-[#94A3B8] dark:text-gray-400 font-medium tracking-wider text-[11px] hidden sm:inline">
          OFFICIAL ACCREDITATION &amp; DIRECT REACH
        </span>
      </div>
      <h2 class="text-2xl sm:text-[32px] font-bold text-[#0F172A] dark:text-white tracking-[-0.02em] mt-1 m-0">
        Grazie per avere visitato il mio potfolio!
      </h2>
      <p class="text-[12.5px] sm:text-[13.5px] font-mono text-[#8B1E2D] dark:text-red-400 max-w-4xl m-0 leading-normal font-semibold uppercase tracking-wider">
        BUILT WITH ASTRO · TYPESCRIPT · TAILWIND CSS · NATIVE CANVAS &amp; WEB AUDIO API
      </p>
    </div>

    <!-- Runner / Anteprima Dinamica (Figma 65:744 - 1311x172) -->
    <div class="w-full flex flex-col gap-2">
      <div class="flex items-center justify-between text-[11px] font-sans text-gray-500 dark:text-gray-400">
        <span class="font-bold tracking-wider uppercase text-gray-700 dark:text-gray-300">
          RUNNER / ANTEPRIMA DINAMICA
        </span>
        <span class="font-mono text-[10.5px] text-[#8B1E2D] dark:text-red-400">
          MINI-GIOCO PROCEDURALE INTEGRATO
        </span>
      </div>
      <RunnerAnteprimaDinamica />
    </div>

    <!-- Direct Contact Card (Swiss Container with Coordinates and Action CTAs) -->
    <div class="bg-white/95 dark:bg-gray-900/90 backdrop-blur-xs border border-gray-200/90 dark:border-gray-800 rounded-[12px] p-6 shadow-md grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
      <!-- Contact Left Info (7 Cols) -->
      <div class="lg:col-span-7 flex flex-col gap-3">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-[4px] bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200/60 dark:border-emerald-800/60 text-emerald-900 dark:text-emerald-300 font-mono text-[11px] font-bold tracking-wider uppercase w-fit">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          DISPONIBILE DA SUBITO · ROMA / REMOTE
        </div>

        <div>
          <h3 class="text-3xl sm:text-[34px] font-bold text-[#0F172A] dark:text-white tracking-[-0.02em] m-0">
            VALERIO COMELLA
          </h3>
          <p class="font-sans text-[15px] font-semibold text-[#8B1E2D] dark:text-red-400 mt-1 m-0">
            Software Engineer | Unity (C#) &amp; Full Stack
          </p>
        </div>

        <p class="text-[13.5px] text-[#374151] dark:text-gray-300 leading-relaxed m-0">
          Cerchi uno sviluppatore con forte padronanza di Unity (C#), solide basi di ingegneria del software e rapidità di inserimento in team di produzione? Inviami un messaggio o fissa un colloquio conoscitivo.
        </p>

        <!-- Coordinates Ledger -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-2 border-t border-gray-100 dark:border-gray-800 font-mono text-[11.5px] text-gray-600 dark:text-gray-400">
          <div>✉️ valeriocom@hotmail.it</div>
          <div>📞 3339959271</div>
          <div>📍 Roma (Napoli 2002)</div>
          <div>🚗 Patente B</div>
        </div>
      </div>

      <!-- Contact Right Channels (5 Cols) -->
      <div class="lg:col-span-5 flex flex-col gap-3 justify-center">
        <a
          href="mailto:valeriocom@hotmail.it"
          class="flex items-center justify-center gap-2 w-full py-3 px-4 rounded-[8px] bg-[#8B1E2D] hover:bg-[#6e1622] text-white font-sans text-[13px] font-bold tracking-wide transition-all shadow-sm no-underline active:scale-98"
        >
          <span>✉️</span> Invia E-mail Diretta (valeriocom@hotmail.it)
        </a>

        <div class="grid grid-cols-2 gap-2.5">
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-[8px] bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 hover:border-[#8B1E2D] dark:hover:border-red-400 text-gray-800 dark:text-gray-200 font-sans text-[12px] font-semibold no-underline transition-all"
          >
            <span>🌐</span> GitHub
          </a>

          <a
            href={linkedinUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-[8px] bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 hover:border-[#8B1E2D] dark:hover:border-red-400 text-gray-800 dark:text-gray-200 font-sans text-[12px] font-semibold no-underline transition-all"
          >
            <span>💼</span> LinkedIn
          </a>
        </div>

        <button
          type="button"
          class="btn-view-pdf flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-[8px] bg-white dark:bg-gray-800 border border-[#8B1E2D] text-[#8B1E2D] dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30 font-sans text-[12px] font-bold tracking-wide transition-all cursor-pointer"
        >
          <span>📑</span> Visualizza Curriculum Vitae (PDF)
        </button>
      </div>
    </div>

    <!-- GDPR Legal Footer -->
    <footer class="pt-2 pb-6 border-t border-gray-200/70 dark:border-gray-800 text-center text-[11px] font-sans text-gray-500 dark:text-gray-400 flex flex-col sm:flex-row items-center justify-between gap-2">
      <div>
        © 2026 Valerio Comella. Autorizzo il trattamento dei miei dati personali ai sensi del Gdpr 679/16 e del D.lgs 196/03.
      </div>
      <div class="font-mono text-[10.5px] text-gray-400">
        Made with Precision &amp; Passion · Swiss Editorial PC 1440
      </div>
    </footer>
  </div>
</section>
