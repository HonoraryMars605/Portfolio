---
// Section 07: Contatti e crediti (Figma 65:614 / 83:1070 - Match Image 6)
import SectionPatternCanvas from "./SectionPatternCanvas.astro"
import RunnerAnteprimaDinamica from "./RunnerAnteprimaDinamica.astro"

export interface Props {
  class?: string
}

const { class: className = "" } = Astro.props
---

<section
  id="section-07"
  class={`section-slide relative w-screen min-w-[100vw] h-full overflow-y-auto px-4 sm:px-8 md:px-12 lg:px-16 flex flex-col justify-center shrink-0 snap-start pt-20 sm:pt-24 pb-8 min-h-full ${className}`}
>
  <SectionPatternCanvas theme="gamedev" />
  <div class="w-full max-w-[1312px] 2xl:max-w-[1560px] 3xl:max-w-[1850px] 4k:max-w-[2200px] mx-auto my-auto flex flex-col justify-center gap-6 sm:gap-7 2xl:gap-8 relative z-10">
    <!-- Section Editorial Header (Figma 65:615 - Match Image 6) -->
    <div class="flex flex-col gap-1.5 pb-2">
      <div class="flex items-center gap-3">
        <div class="inline-flex items-center px-3 py-1 rounded-[6px] 2xl:rounded-[8px] bg-swiss-crimson-light dark:bg-[#380A10] border border-swiss-crimson-border dark:border-red-900 text-swiss-crimson dark:text-red-300 font-bold text-[11px] 2xl:text-[13px] tracking-wide">
          07 // RIMANIAMO IN CONTATTO?
        </div>
      </div>
      <h2 class="text-2xl sm:text-[32px] 2xl:text-[38px] 3xl:text-[44px] font-bold text-[#0F172A] dark:text-white tracking-[-0.02em] mt-1 m-0">
        Grazie per avere visitato il mio potfolio!
      </h2>
      <p class="text-[12px] sm:text-[13px] 2xl:text-[15px] font-mono text-[#64748B] dark:text-gray-400 max-w-4xl 2xl:max-w-5xl m-0 leading-normal font-medium tracking-wide">
        BUILT WITH FIGMA · ASTRO · TYPESCRIPT · TAILWIND CSS · NATIVE CANVAS &amp; WEB AUDIO API // ASSISTITO DA AGENT WORKFLOW (ANTIGRAVITY &amp; MCP)
      </p>
    </div>

    <!-- Runner / Anteprima Dinamica (Figma 65:744 - 1311x172) -->
    <div class="w-full flex flex-col gap-2 pt-2 2xl:pt-4">
      <RunnerAnteprimaDinamica />
    </div>
  </div>
</section>
