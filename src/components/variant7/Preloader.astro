---
// Preloader Modal Card · Desktop (Figma media_1795190035618_35143e11.png)
// Clean 1:1 editorial preloader card with title, role, progress percentage and progress bar
---

<div
  id="preloader-overlay"
  class="fixed inset-0 z-50 bg-[#FAF9F5]/95 dark:bg-[#0C1017]/95 backdrop-blur-md flex items-center justify-center p-4 transition-opacity duration-600 select-none"
  role="dialog"
  aria-modal="true"
  aria-label="Preloader · Swiss Editorial · PC · 1440"
>
  <!-- Preloader Modal Card · Desktop (Match Image 10) -->
  <div class="w-full max-w-[520px] bg-white dark:bg-[#111827] rounded-[14px] 2xl:rounded-[18px] p-7 sm:p-8 shadow-[0_12px_40px_rgba(0,0,0,0.08)] border border-gray-100 dark:border-gray-800 flex flex-col gap-4 transform transition-all duration-400">
    <!-- Header: Nome & Ruolo -->
    <div class="flex flex-col gap-1.5">
      <h1 class="text-3xl sm:text-[36px] 2xl:text-[40px] font-extrabold text-[#0F172A] dark:text-white tracking-[-0.02em] m-0 font-heading leading-tight">
        Valerio Comella
      </h1>
      <h2 class="text-base sm:text-[18px] 2xl:text-[20px] font-semibold text-swiss-crimson dark:text-red-400 tracking-[-0.01em] m-0 font-sans">
        Software Engineer | Unity (C#) &amp; Full Stack
      </h2>
    </div>

    <!-- Sottile linea divisoria -->
    <div class="w-full h-px bg-gray-100 dark:bg-gray-800 my-1"></div>

    <!-- Caricamento Portfolio in corso & Percentuale -->
    <div class="flex items-center justify-between text-[12px] 2xl:text-[13px] font-mono">
      <span class="text-[#64748B] dark:text-gray-400 font-medium">
        Caricamento Portfolio in corso
      </span>
      <span id="loader-percent" class="font-bold text-swiss-crimson dark:text-red-400">
        72%
      </span>
    </div>

    <!-- Barra di progresso -->
    <div class="w-full h-[6px] 2xl:h-[7px] rounded-full bg-gray-100 dark:bg-gray-800 overflow-hidden">
      <div
        id="loader-progress-bar"
        class="h-full rounded-full bg-swiss-crimson dark:bg-red-500 transition-all duration-300 ease-out"
        style="width: 72%;"
      ></div>
    </div>
  </div>
</div>

<script>
  function setupPreloader() {
    const overlay = document.getElementById("preloader-overlay")
    const percentEl = document.getElementById("loader-percent")
    const barEl = document.getElementById("loader-progress-bar")

    if (!overlay || !percentEl || !barEl) return

    let current = 15
    const interval = setInterval(() => {
      current += Math.floor(Math.random() * 18) + 8
      if (current >= 100) {
        current = 100
        percentEl.textContent = "100%"
        barEl.style.width = "100%"
        clearInterval(interval)

        setTimeout(() => {
          overlay.style.opacity = "0"
          setTimeout(() => {
            overlay.classList.add("hidden")
          }, 600)
        }, 300)
      } else {
        percentEl.textContent = `${current}%`
        barEl.style.width = `${current}%`
      }
    }, 90)
  }

  setupPreloader()
</script>
