---
// Floating Navigation Dock / Right Rail (Figma 44:3818 - Match Image 8)
const sections = [
  { id: "01", label: "Hero" },
  { id: "02", label: "Profilo" },
  { id: "03", label: "Esperienze" },
  { id: "04", label: "Progetti" },
  { id: "05", label: "Formazione" },
  { id: "06", label: "Cosa Mi Piace" },
]
---

<aside
  class="fixed right-3 sm:right-5 2xl:right-8 top-1/2 -translate-y-1/2 z-40 w-[45px] 2xl:w-[54px] 3xl:w-[60px] bg-white/95 dark:bg-[#111827]/95 backdrop-blur-md border border-[#E5E7EB] dark:border-gray-800 rounded-[22px] 2xl:rounded-[26px] py-3.5 px-1.5 flex flex-col items-center gap-2 shadow-md select-none transition-all"
  aria-label="Navigazione rapida sezioni orizzontali"
>
  <!-- Prev Button -->
  <button
    id="rail-prev-btn"
    type="button"
    class="w-7 h-7 2xl:w-8 2xl:h-8 rounded-[6px] flex items-center justify-center text-[#475569] dark:text-gray-400 hover:text-black dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors text-xs 2xl:text-sm font-bold border-none bg-transparent cursor-pointer active:scale-90"
    title="Sezione precedente"
  >
    ‹
  </button>

  <!-- Number Dots -->
  <div class="flex flex-col gap-1 2xl:gap-1.5">
    {
      sections.map((sec, idx) => (
        <button
          type="button"
          data-rail-target={sec.id}
          class={`rail-dot w-[31px] h-[31px] 2xl:w-[38px] 2xl:h-[38px] rounded-[6px] 2xl:rounded-[8px] flex items-center justify-center font-sans text-[13px] 2xl:text-[15px] font-bold transition-all border-none cursor-pointer ${
            idx === 0
              ? "bg-[#8B1E2D] text-white shadow-2xs"
              : "bg-transparent text-[#475569] dark:text-gray-400 hover:text-[#8B1E2D] hover:bg-red-50/50 dark:hover:bg-red-950/30"
          }`}
          title={`Sezione ${sec.id} - ${sec.label}`}
        >
          {sec.id}
        </button>
      ))
    }
  </div>

  <!-- Next Button -->
  <button
    id="rail-next-btn"
    type="button"
    class="w-7 h-7 2xl:w-8 2xl:h-8 rounded-[6px] flex items-center justify-center text-[#475569] dark:text-gray-400 hover:text-black dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors text-xs 2xl:text-sm font-bold border-none bg-transparent cursor-pointer active:scale-90"
    title="Sezione successiva"
  >
    ›
  </button>
</aside>

<script>
  function setupRail() {
    const dots = document.querySelectorAll(".rail-dot")
    const container = document.getElementById("horizontal-slider-container")
    const prevBtn = document.getElementById("rail-prev-btn")
    const nextBtn = document.getElementById("rail-next-btn")

    let currentSectionIdx = 0
    const sectionIds = ["01", "02", "03", "04", "05", "06", "07"]

    function updateActiveDot(idx: number) {
      currentSectionIdx = idx
      dots.forEach((d, i) => {
        if (i === idx) {
          d.classList.add("bg-[#8B1E2D]", "text-white", "shadow-2xs")
          d.classList.remove("text-[#475569]", "dark:text-gray-400", "bg-transparent")
        } else {
          d.classList.remove("bg-[#8B1E2D]", "text-white", "shadow-2xs")
          d.classList.add("text-[#475569]", "dark:text-gray-400", "bg-transparent")
        }
      })
    }

    dots.forEach((dot, idx) => {
      dot.addEventListener("click", () => {
        const targetId = (dot as HTMLElement).dataset.railTarget
        const sec = document.getElementById(`section-${targetId}`)
        if (sec) {
          sec.scrollIntoView({ behavior: "smooth", inline: "start" })
          updateActiveDot(idx)
          if ((window as any).playSfx) (window as any).playSfx("slide")
        }
      })
    })

    if (prevBtn) {
      prevBtn.onclick = () => {
        if (currentSectionIdx > 0) {
          const targetId = sectionIds[currentSectionIdx - 1]
          const sec = document.getElementById(`section-${targetId}`)
          if (sec) {
            sec.scrollIntoView({ behavior: "smooth", inline: "start" })
            updateActiveDot(Math.min(currentSectionIdx - 1, dots.length - 1))
            if ((window as any).playSfx) (window as any).playSfx("slide")
          }
        }
      }
    }

    if (nextBtn) {
      nextBtn.onclick = () => {
        if (currentSectionIdx < sectionIds.length - 1) {
          const targetId = sectionIds[currentSectionIdx + 1]
          const sec = document.getElementById(`section-${targetId}`)
          if (sec) {
            sec.scrollIntoView({ behavior: "smooth", inline: "start" })
            updateActiveDot(Math.min(currentSectionIdx + 1, dots.length - 1))
            if ((window as any).playSfx) (window as any).playSfx("slide")
          }
        }
      }
    }

    // IntersectionObserver to update active dot on scroll
    if (container) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const secId = entry.target.id.replace("section-", "")
              const idx = sectionIds.indexOf(secId)
              if (idx !== -1) updateActiveDot(Math.min(idx, dots.length - 1))
            }
          })
        },
        { root: container, threshold: 0.5 }
      )

      sectionIds.forEach((id) => {
        const el = document.getElementById(`section-${id}`)
        if (el) observer.observe(el)
      })
    }

    updateActiveDot(0)
  }

  setupRail()
  document.addEventListener("astro:after-swap", setupRail)
</script>
