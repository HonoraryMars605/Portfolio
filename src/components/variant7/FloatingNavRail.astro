---
// Floating Navigation Dock (Figma media_1795184258925_9939f6ef.png)
// Horizontal dock capsule with ‹ [01] 02 03 04 05 06 07 ›
export interface Props {
  class?: string
}

const { class: className = "" } = Astro.props

const sections = [
  { id: "01", label: "Chi Sono" },
  { id: "02", label: "Competenze" },
  { id: "03", label: "Esperienze" },
  { id: "04", label: "Progetti" },
  { id: "05", label: "Formazione" },
  { id: "06", label: "Passioni" },
  { id: "07", label: "Contatti" },
]
---

<nav
  class={`fixed bottom-5 sm:bottom-6 inset-x-0 mx-auto w-fit z-40 bg-white/95 dark:bg-[#111827]/95 backdrop-blur-md border border-[#E5E7EB] dark:border-gray-800 rounded-[22px] 2xl:rounded-[26px] py-1.5 px-3 sm:px-4 flex items-center gap-1.5 sm:gap-2 2xl:gap-2.5 shadow-lg select-none transition-all ${className}`}
  aria-label="Navigazione rapida sezioni orizzontali"
>
  <!-- Prev Button -->
  <button
    id="rail-prev-btn"
    type="button"
    class="w-7 h-7 2xl:w-8 2xl:h-8 rounded-[6px] flex items-center justify-center text-[#475569] dark:text-gray-400 hover:text-black dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors text-xs 2xl:text-sm font-bold border-none bg-transparent cursor-pointer active:scale-90"
    title="Sezione precedente"
  >
    ‹
  </button>

  <!-- Number Dots (01 to 07) -->
  <div class="flex items-center gap-1 sm:gap-1.5">
    {
      sections.map((sec, idx) => (
        <button
          type="button"
          data-rail-target={sec.id}
          class={`rail-dot w-[30px] h-[30px] sm:w-[32px] sm:h-[32px] 2xl:w-[38px] 2xl:h-[38px] rounded-[7px] 2xl:rounded-[9px] flex items-center justify-center font-sans text-[12.5px] sm:text-[13px] 2xl:text-[15px] font-bold transition-all border-none cursor-pointer ${
            idx === 0
              ? "bg-swiss-crimson text-white shadow-2xs"
              : "bg-transparent text-[#475569] dark:text-gray-400 hover:text-swiss-crimson hover:bg-red-50/50 dark:hover:bg-red-950/30"
          }`}
          title={`Sezione ${sec.id} - ${sec.label}`}
        >
          {sec.id}
        </button>
      ))
    }
  </div>

  <!-- Next Button -->
  <button
    id="rail-next-btn"
    type="button"
    class="w-7 h-7 2xl:w-8 2xl:h-8 rounded-[6px] flex items-center justify-center text-[#475569] dark:text-gray-400 hover:text-black dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors text-xs 2xl:text-sm font-bold border-none bg-transparent cursor-pointer active:scale-90"
    title="Sezione successiva"
  >
    ›
  </button>
</nav>

<script>
  function setupRail() {
    const dots = document.querySelectorAll(".rail-dot")
    const container = document.getElementById("horizontal-slider-container")
    const prevBtn = document.getElementById("rail-prev-btn")
    const nextBtn = document.getElementById("rail-next-btn")

    let currentSectionIdx = 0
    const sectionIds = ["01", "02", "03", "04", "05", "06", "07"]

    function updateActiveDot(idx: number) {
      currentSectionIdx = idx
      dots.forEach((d, i) => {
        if (i === idx) {
          d.classList.add("bg-swiss-crimson", "text-white", "shadow-2xs")
          d.classList.remove("text-[#475569]", "dark:text-gray-400", "bg-transparent")
        } else {
          d.classList.remove("bg-swiss-crimson", "text-white", "shadow-2xs")
          d.classList.add("text-[#475569]", "dark:text-gray-400", "bg-transparent")
        }
      })
    }

    dots.forEach((dot, idx) => {
      dot.addEventListener("click", () => {
        const targetId = (dot as HTMLElement).dataset.railTarget
        const sec = document.getElementById(`section-${targetId}`)
        if (sec) {
          sec.scrollIntoView({ behavior: "smooth", inline: "start" })
          updateActiveDot(idx)
          if ((window as any).playSfx) (window as any).playSfx("slide")
        }
      })
    })

    if (prevBtn) {
      prevBtn.onclick = () => {
        if (currentSectionIdx > 0) {
          const targetId = sectionIds[currentSectionIdx - 1]
          const sec = document.getElementById(`section-${targetId}`)
          if (sec) {
            sec.scrollIntoView({ behavior: "smooth", inline: "start" })
            updateActiveDot(currentSectionIdx - 1)
            if ((window as any).playSfx) (window as any).playSfx("slide")
          }
        }
      }
    }

    if (nextBtn) {
      nextBtn.onclick = () => {
        if (currentSectionIdx < sectionIds.length - 1) {
          const targetId = sectionIds[currentSectionIdx + 1]
          const sec = document.getElementById(`section-${targetId}`)
          if (sec) {
            sec.scrollIntoView({ behavior: "smooth", inline: "start" })
            updateActiveDot(currentSectionIdx + 1)
            if ((window as any).playSfx) (window as any).playSfx("slide")
          }
        }
      }
    }

    // IntersectionObserver to update active dot on scroll
    if (container) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
              const secId = entry.target.id.replace("section-", "")
              const idx = sectionIds.indexOf(secId)
              if (idx !== -1) updateActiveDot(idx)
            }
          })
        },
        { root: container, threshold: 0.5 }
      )

      sectionIds.forEach((id) => {
        const el = document.getElementById(`section-${id}`)
        if (el) observer.observe(el)
      })
    }

    updateActiveDot(0)
  }

  setupRail()
  document.addEventListener("astro:after-swap", setupRail)
</script>
