---
// Section 02: Competenze (Figma media_1795189813545_6ef6219b.png - 1:1 Match)
import SectionPatternCanvas from "./SectionPatternCanvas.astro"

export interface Props {
  class?: string
}

const { class: className = "" } = Astro.props
---

<section
  id="section-02"
  class={`section-slide relative w-screen min-w-[100vw] h-full overflow-y-auto px-4 sm:px-8 md:px-12 lg:px-16 flex flex-col justify-center shrink-0 snap-start pt-20 sm:pt-24 pb-8 min-h-full ${className}`}
>
  <SectionPatternCanvas theme="code" />
  <div class="w-full max-w-[1312px] 2xl:max-w-[1560px] 3xl:max-w-[1850px] 4k:max-w-[2200px] mx-auto my-auto flex flex-col justify-center gap-6 2xl:gap-8 relative z-10">
    <!-- Section Editorial Header -->
    <div class="flex flex-col gap-1.5 pb-2">
      <div class="flex items-center gap-3">
        <div class="inline-flex items-center px-3 py-1 rounded-[6px] 2xl:rounded-[8px] bg-swiss-crimson-light dark:bg-[#380A10] border border-swiss-crimson-border dark:border-red-900 text-swiss-crimson dark:text-red-300 font-bold text-[11px] 2xl:text-[13px] tracking-wide font-mono">
          02 // COSA SO FARE?
        </div>
      </div>
      <h2 class="text-2xl sm:text-[32px] 2xl:text-[38px] 3xl:text-[44px] font-bold text-[#0F172A] dark:text-white tracking-[-0.02em] mt-1 m-0">
        Il mio Stack
      </h2>
      <p class="text-[14px] sm:text-[15px] 2xl:text-[17px] 3xl:text-[19px] text-[#64748B] dark:text-gray-300 max-w-4xl 2xl:max-w-5xl m-0 leading-normal">
        Dal game programming alle architetture full-stack: la mappa completa delle competenze che ho curato nel tempo e che continuo ad approfondire
      </p>
    </div>

    <!-- 3 Colonne Competenze (Figma media_1795189813545_6ef6219b.png) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 2xl:gap-8 items-start">
      <!-- Categoria 1: GAME DEV & ENGINE AREA -->
      <div class="bg-white dark:bg-gray-900 border border-gray-200/90 dark:border-gray-800 rounded-[14px] 2xl:rounded-[18px] p-6 2xl:p-7 flex flex-col gap-5 2xl:gap-6 shadow-2xs">
        <h3 class="font-bold text-[12px] 2xl:text-[14px] tracking-wider uppercase text-[#0F172A] dark:text-gray-200 m-0 font-sans">
          GAME DEV &amp; ENGINE AREA
        </h3>

        <div class="flex flex-col gap-4 2xl:gap-5">
          <!-- Unity (C#) -->
          <div class="flex items-center gap-3 2xl:gap-4">
            <div class="w-9 h-9 2xl:w-11 2xl:h-11 shrink-0 rounded-[8px] 2xl:rounded-[10px] bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 p-1 flex items-center justify-center">
              <img
                src="/assets/variant7/v2_icons/unity.png"
                alt="Unity"
                class="w-full h-full object-contain"
              />
            </div>
            <div class="flex flex-col">
              <span class="text-[13px] 2xl:text-[15px] 3xl:text-[16px] font-bold text-[#0F172A] dark:text-gray-100 leading-snug">Unity (C#)</span>
              <span class="text-[11px] 2xl:text-[12.5px] text-[#64748B] dark:text-gray-400 leading-tight">Competenza Avanzata</span>
            </div>
          </div>

          <!-- Unreal Engine 5 -->
          <div class="flex items-center gap-3 2xl:gap-4">
            <div class="w-9 h-9 2xl:w-11 2xl:h-11 shrink-0 rounded-[8px] 2xl:rounded-[10px] bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 p-1 flex items-center justify-center">
              <img
                src="/assets/variant7/v2_icons/unreal.png"
                alt="Unreal Engine 5"
                class="w-full h-full object-contain"
              />
            </div>
            <div class="flex flex-col">
              <span class="text-[13px] 2xl:text-[15px] 3xl:text-[16px] font-bold text-[#0F172A] dark:text-gray-100 leading-snug">Unreal Engine 5 (Blueprint - C++)</span>
              <span class="text-[11px] 2xl:text-[12.5px] text-[#64748B] dark:text-gray-400 leading-tight">Competenza Intermedia</span>
            </div>
          </div>

          <!-- Blender & Maya -->
          <div class="flex items-center gap-3 2xl:gap-4">
            <div class="h-9 2xl:h-11 px-1.5 shrink-0 rounded-[8px] 2xl:rounded-[10px] bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 flex items-center justify-center">
              <img
                src="/assets/variant7/v2_icons/blender_maya.png"
                alt="Blender & Maya"
                class="h-7 2xl:h-8 object-contain"
              />
            </div>
            <div class="flex flex-col">
              <span class="text-[13px] 2xl:text-[15px] 3xl:text-[16px] font-bold text-[#0F172A] dark:text-gray-100 leading-snug">Blender &amp; Maya</span>
              <span class="text-[11px] 2xl:text-[12.5px] text-[#64748B] dark:text-gray-400 leading-tight">Modellazione 3D, UV mapping, rigging e animazione asset</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Categoria 2: FULL STACK AREA -->
      <div class="bg-white dark:bg-gray-900 border border-gray-200/90 dark:border-gray-800 rounded-[14px] 2xl:rounded-[18px] p-6 2xl:p-7 flex flex-col gap-5 2xl:gap-6 shadow-2xs">
        <h3 class="font-bold text-[12px] 2xl:text-[14px] tracking-wider uppercase text-[#0F172A] dark:text-gray-200 m-0 font-sans">
          FULL STACK AREA
        </h3>

        <div class="flex flex-col gap-4 2xl:gap-5">
          <!-- C#, Java & Spring Boot -->
          <div class="flex items-center gap-3 2xl:gap-4">
            <div class="h-9 2xl:h-11 px-1.5 shrink-0 rounded-[8px] 2xl:rounded-[10px] bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 flex items-center justify-center">
              <img
                src="/assets/variant7/v2_icons/java_spring.png"
                alt="C#, Java & Spring Boot"
                class="h-7 2xl:h-8 object-contain"
              />
            </div>
            <div class="flex flex-col">
              <span class="text-[13px] 2xl:text-[15px] 3xl:text-[16px] font-bold text-[#0F172A] dark:text-gray-100 leading-snug">C#, Java &amp; Spring Boot</span>
              <span class="text-[11px] 2xl:text-[12.5px] text-[#64748B] dark:text-gray-400 leading-tight">Competenza Intermedia</span>
            </div>
          </div>

          <!-- PostgreSQL & MySQL -->
          <div class="flex items-center gap-3 2xl:gap-4">
            <div class="h-9 2xl:h-11 px-1.5 shrink-0 rounded-[8px] 2xl:rounded-[10px] bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 flex items-center justify-center">
              <img
                src="/assets/variant7/v2_icons/postgres_mysql.png"
                alt="PostgreSQL & MySQL"
                class="h-7 2xl:h-8 object-contain"
              />
            </div>
            <div class="flex flex-col">
              <span class="text-[13px] 2xl:text-[15px] 3xl:text-[16px] font-bold text-[#0F172A] dark:text-gray-100 leading-snug">PostgreSQL &amp; MySQL</span>
              <span class="text-[11px] 2xl:text-[12.5px] text-[#64748B] dark:text-gray-400 leading-tight">Competenza Intermedia</span>
            </div>
          </div>

          <!-- HTML5, CSS3 & JavaScript -->
          <div class="flex items-center gap-3 2xl:gap-4">
            <div class="h-9 2xl:h-11 px-1.5 shrink-0 rounded-[8px] 2xl:rounded-[10px] bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 flex items-center justify-center">
              <img
                src="/assets/variant7/v2_icons/web_stack.png"
                alt="HTML5, CSS3 & JavaScript"
                class="h-7 2xl:h-8 object-contain"
              />
            </div>
            <div class="flex flex-col">
              <span class="text-[13px] 2xl:text-[15px] 3xl:text-[16px] font-bold text-[#0F172A] dark:text-gray-100 leading-snug">HTML5, CSS3 &amp; JavaScript</span>
              <span class="text-[11px] 2xl:text-[12.5px] text-[#64748B] dark:text-gray-400 leading-tight">Competenza Intermedia</span>
            </div>
          </div>

          <!-- C & Python -->
          <div class="flex items-center gap-3 2xl:gap-4">
            <div class="h-9 2xl:h-11 px-1.5 shrink-0 rounded-[8px] 2xl:rounded-[10px] bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 flex items-center justify-center">
              <img
                src="/assets/variant7/v2_icons/c_python.png"
                alt="C & Python"
                class="h-7 2xl:h-8 object-contain"
              />
            </div>
            <div class="flex flex-col">
              <span class="text-[13px] 2xl:text-[15px] 3xl:text-[16px] font-bold text-[#0F172A] dark:text-gray-100 leading-snug">C &amp; Python</span>
              <span class="text-[11px] 2xl:text-[12.5px] text-[#64748B] dark:text-gray-400 leading-tight">Competenza Base</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Categoria 3: WORKFLOW, TOOLING, DESIGN & OTHERS AREA -->
      <div class="bg-white dark:bg-gray-900 border border-gray-200/90 dark:border-gray-800 rounded-[14px] 2xl:rounded-[18px] p-6 2xl:p-7 flex flex-col gap-5 2xl:gap-6 shadow-2xs">
        <h3 class="font-bold text-[12px] 2xl:text-[14px] tracking-wider uppercase text-[#0F172A] dark:text-gray-200 m-0 font-sans">
          WORKFLOW, TOOLING, DESIGN &amp; OTHERS AREA
        </h3>

        <div class="flex flex-col gap-4 2xl:gap-5">
          <!-- Git & GitHub -->
          <div class="flex items-center gap-3 2xl:gap-4">
            <div class="h-9 2xl:h-11 px-1.5 shrink-0 rounded-[8px] 2xl:rounded-[10px] bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 flex items-center justify-center">
              <img
                src="/assets/variant7/v2_icons/git_github.png"
                alt="Git & GitHub"
                class="h-7 2xl:h-8 object-contain"
              />
            </div>
            <div class="flex flex-col">
              <span class="text-[13px] 2xl:text-[15px] 3xl:text-[16px] font-bold text-[#0F172A] dark:text-gray-100 leading-snug">Git &amp; GitHub</span>
              <span class="text-[11px] 2xl:text-[12.5px] text-[#64748B] dark:text-gray-400 leading-tight">Competenza Avanzata</span>
            </div>
          </div>

          <!-- Figma & Canva -->
          <div class="flex items-center gap-3 2xl:gap-4">
            <div class="h-9 2xl:h-11 px-1.5 shrink-0 rounded-[8px] 2xl:rounded-[10px] bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 flex items-center justify-center">
              <img
                src="/assets/variant7/v2_icons/figma_canva.png"
                alt="Figma & Canva"
                class="h-7 2xl:h-8 object-contain"
              />
            </div>
            <div class="flex flex-col">
              <span class="text-[13px] 2xl:text-[15px] 3xl:text-[16px] font-bold text-[#0F172A] dark:text-gray-100 leading-snug">Figma &amp; Canva</span>
              <span class="text-[11px] 2xl:text-[12.5px] text-[#64748B] dark:text-gray-400 leading-tight">Competenza Intermedia</span>
            </div>
          </div>

          <!-- Trello, Notion, Milanote & Miro -->
          <div class="flex items-center gap-3 2xl:gap-4">
            <div class="h-9 2xl:h-11 px-1.5 shrink-0 rounded-[8px] 2xl:rounded-[10px] bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 flex items-center justify-center">
              <img
                src="/assets/variant7/v2_icons/project_tools.png"
                alt="Trello, Notion, Milanote & Miro"
                class="h-7 2xl:h-8 object-contain"
              />
            </div>
            <div class="flex flex-col">
              <span class="text-[13px] 2xl:text-[15px] 3xl:text-[16px] font-bold text-[#0F172A] dark:text-gray-100 leading-snug">Trello, Notion, Milanote &amp; Miro</span>
              <span class="text-[11px] 2xl:text-[12.5px] text-[#64748B] dark:text-gray-400 leading-tight">Competenza Intermedia</span>
            </div>
          </div>

          <!-- Visual Studio, VS Code, IntelliJ IDEA & Antigravity -->
          <div class="flex items-center gap-3 2xl:gap-4">
            <div class="h-9 2xl:h-11 px-1.5 shrink-0 rounded-[8px] 2xl:rounded-[10px] bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 flex items-center justify-center">
              <img
                src="/assets/variant7/v2_icons/ides.png"
                alt="Visual Studio, VS Code, IntelliJ IDEA & Antigravity"
                class="h-7 2xl:h-8 object-contain"
              />
            </div>
            <div class="flex flex-col">
              <span class="text-[13px] 2xl:text-[15px] 3xl:text-[16px] font-bold text-[#0F172A] dark:text-gray-100 leading-snug">Visual Studio, VS Code, IntelliJ IDEA &amp; Antigravity</span>
              <span class="text-[11px] 2xl:text-[12.5px] text-[#64748B] dark:text-gray-400 leading-tight">Competenza Avanzata</span>
            </div>
          </div>

          <!-- AI & Prompt Eng. -->
          <div class="flex items-center gap-3 2xl:gap-4">
            <div class="h-9 2xl:h-11 px-1.5 shrink-0 rounded-[8px] 2xl:rounded-[10px] bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 flex items-center justify-center">
              <img
                src="/assets/variant7/v2_icons/ai_prompt.png"
                alt="AI & Prompt Eng."
                class="h-7 2xl:h-8 object-contain"
              />
            </div>
            <div class="flex flex-col">
              <span class="text-[13px] 2xl:text-[15px] 3xl:text-[16px] font-bold text-[#0F172A] dark:text-gray-100 leading-snug">AI &amp; Prompt Eng.</span>
              <span class="text-[11px] 2xl:text-[12.5px] text-[#64748B] dark:text-gray-400 leading-tight">Competenza Intermedia</span>
            </div>
          </div>

          <!-- Video Editing -->
          <div class="flex items-center gap-3 2xl:gap-4">
            <div class="h-9 2xl:h-11 px-1.5 shrink-0 rounded-[8px] 2xl:rounded-[10px] bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 flex items-center justify-center">
              <img
                src="/assets/variant7/v2_icons/video_editing.png"
                alt="Video Editing"
                class="h-7 2xl:h-8 object-contain"
              />
            </div>
            <div class="flex flex-col">
              <span class="text-[13px] 2xl:text-[15px] 3xl:text-[16px] font-bold text-[#0F172A] dark:text-gray-100 leading-snug">Video Editing</span>
              <span class="text-[11px] 2xl:text-[12.5px] text-[#64748B] dark:text-gray-400 leading-tight">Competenza Base</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
