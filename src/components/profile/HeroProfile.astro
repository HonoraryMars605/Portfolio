---
import { Image } from "astro:assets"
import avatarImg from "@/assets/avatar.png"
import { PROFILE } from "@/site.config"

interface Props {
  name?: string
  tagline?: string
  location?: string
  email?: string
  links?: typeof PROFILE.links
  class?: string
}

const {
  name = PROFILE.name,
  tagline = PROFILE.tagline,
  location = PROFILE.location,
  email = PROFILE.email,
  links = PROFILE.links,
  class: className = "",
} = Astro.props

const linkedinHref = typeof links.linkedin === "object" ? links.linkedin?.href : links.linkedin || "https://www.linkedin.com/in/valerio-comella-6a5693241/"
---

<section class:list={["w-full overflow-hidden rounded-3xl border border-zinc-200 bg-white/90 backdrop-blur-sm shadow-sm dark:border-zinc-800 dark:bg-zinc-900/90 mb-10", className]}>
  <!-- Banner Superiore LinkedIn Style -->
  <div class="h-28 bg-gradient-to-r from-[#0077B5] via-[#0A66C2] to-sky-700"></div>

  <div class="px-6 pb-6 pt-0">
    <!-- Avatar Pulito e Pulsante LinkedIn -->
    <div class="-mt-14 mb-4 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div class="relative w-fit">
        <Image
          src={avatarImg}
          alt={name}
          width={112}
          height={112}
          quality={95}
          format="webp"
          loading="eager"
          class="h-28 w-28 rounded-full border-4 border-white object-cover shadow-md dark:border-zinc-900 bg-zinc-100 dark:bg-zinc-800"
        />
      </div>

      <!-- Singolo Pulsante di Azione: Connettiti su LinkedIn -->
      <div>
        <a
          href={linkedinHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl bg-[#0A66C2] px-4 py-2 text-xs font-semibold text-white shadow-sm hover:bg-[#004182] transition-colors"
        >
          <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
          </svg>
          Connettiti su LinkedIn
        </a>
      </div>
    </div>

    <!-- Info Testuali -->
    <div class="space-y-3">
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">{name}</h1>
          <span class="rounded-md bg-blue-50 px-2 py-0.5 text-xs font-semibold text-blue-700 dark:bg-blue-950/50 dark:text-blue-300">1°</span>
        </div>
        <p class="text-sm sm:text-base font-medium text-zinc-700 dark:text-zinc-300 mt-0.5">
          {tagline}
        </p>
      </div>

      <p class="text-xs sm:text-sm leading-relaxed text-zinc-600 dark:text-zinc-400 max-w-3xl">
        Unity Developer specializzato in <strong>C#</strong>, con esperienza nello sviluppo di applicazioni interattive, soluzioni <strong>Mixed Reality (zSpace/XR)</strong> e prodotti <strong>B2B WebGL</strong>. Solida formazione in <strong>Game Development & MR (ITS EQF5)</strong>, con competenze <strong>Full Stack</strong>.
      </p>

      <!-- Dati di Contatto essenziali -->
      <div class="pt-3 flex flex-wrap items-center gap-y-2 gap-x-6 text-xs text-zinc-500 dark:text-zinc-400 border-t border-zinc-100 dark:border-zinc-800">
        <div class="flex items-center gap-1.5">
          <svg class="h-4 w-4 shrink-0 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>{location}</span>
        </div>

        <div class="flex items-center gap-1.5">
          <svg class="h-4 w-4 shrink-0 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <a href={`mailto:${email}`} class="hover:text-[#0A66C2] transition-colors">{email}</a>
        </div>
      </div>
    </div>
  </div>
</section>
