---
import Icon from "@/components/base/Icon.astro"

interface Props {
  work: Array<{
    id: string
    title: string
    org: string
    contractType?: string
    period: string
    location?: string
    description: string
  }>
  education: Array<{
    id: string
    title: string
    org: string
    badge?: string
    period: string
    location?: string
    description: string
  }>
}

const { work = [], education = [] } = Astro.props
---

<div class="career-experience-container">
  <!-- 1. Formazione & Istruzione (FIRST) -->
  <section class="career-section">
    <div class="section-header">
      <div class="section-title-group">
        <Icon name="academicons:open-access" class="section-icon" size="1.35rem" />
        <h3 class="section-title">Formazione & Istruzione</h3>
      </div>
      <span class="section-count-badge">{education.length} titoli</span>
    </div>

    <div class="career-list">
      {education.map((item) => (
        <article class="career-card education-card">
          <div class="card-header-row">
            <span class="career-period">{item.period}</span>
            {item.badge && (
              <span class="career-badge grade-badge">{item.badge}</span>
            )}
          </div>

          <h4 class="career-title">{item.title}</h4>

          <div class="career-institution-row">
            <span class="institution-name">{item.org}</span>
            {item.location && <span class="career-location"> · {item.location}</span>}
          </div>

          <p class="career-description">{item.description}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- 2. Esperienze Lavorative (SECOND) -->
  <section class="career-section">
    <div class="section-header">
      <div class="section-title-group">
        <Icon name="mingcute:briefcase-line" class="section-icon" size="1.35rem" />
        <h3 class="section-title">Esperienze Lavorative</h3>
      </div>
      <span class="section-count-badge">{work.length} esperienze</span>
    </div>

    <div class="career-list">
      {work.map((item) => (
        <article class="career-card work-card">
          <div class="card-header-row">
            <span class="career-period">{item.period}</span>
            {item.contractType && (
              <span class="career-badge contract-badge">{item.contractType}</span>
            )}
          </div>

          <h4 class="career-title">{item.title}</h4>

          <div class="career-institution-row">
            <span class="company-name">{item.org}</span>
            {item.location && <span class="career-location"> · {item.location}</span>}
          </div>

          <p class="career-description">{item.description}</p>
        </article>
      ))}
    </div>
  </section>
</div>

<style>
  .career-experience-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    margin-block-start: var(--space-s);
  }

  .career-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block-end: 0.5rem;
    border-block-end: 2px solid var(--border);
  }

  .section-title-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .section-icon {
    color: var(--primary);
  }

  .section-title {
    margin: 0;
    font-size: var(--step-0);
    font-weight: var(--font-weight-bold);
    color: var(--foreground);
  }

  .section-count-badge {
    font-size: 0.75rem;
    font-weight: var(--font-weight-medium);
    color: var(--muted-foreground);
  }

  .career-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .career-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: var(--space-s);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    transition: border-color var(--motion-duration) var(--motion-ease), box-shadow var(--motion-duration) var(--motion-ease);
  }

  .career-card:hover {
    border-color: color-mix(in srgb, var(--primary) 50%, var(--border));
    box-shadow: 0 4px 16px -4px color-mix(in srgb, var(--primary) 12%, transparent);
  }

  .card-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .career-period {
    font-size: 0.8rem;
    font-weight: var(--font-weight-semibold);
    color: var(--muted-foreground);
  }

  .career-badge {
    font-size: 0.72rem;
    font-weight: var(--font-weight-bold);
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-sm);
  }

  .contract-badge {
    background: var(--accent-soft);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    color: var(--accent);
  }

  .grade-badge {
    background: color-mix(in srgb, #10B981 12%, var(--surface));
    border: 1px solid color-mix(in srgb, #10B981 35%, transparent);
    color: #10B981;
  }

  .career-title {
    margin: 0;
    font-size: var(--step-0);
    font-weight: var(--font-weight-bold);
    color: var(--foreground);
    line-height: 1.3;
  }

  .career-institution-row {
    font-size: var(--step--1);
    color: var(--muted-foreground);
  }

  .company-name,
  .institution-name {
    font-weight: var(--font-weight-bold);
    color: var(--primary);
  }

  .career-location {
    color: var(--muted-foreground);
  }

  .career-description {
    margin: 0.25rem 0 0 0;
    font-size: var(--step--1);
    color: var(--muted-foreground);
    line-height: 1.45;
  }
</style>
