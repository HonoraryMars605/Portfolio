---
import Link from "@/components/base/Link.astro"

interface Props {
  username?: string
  class?: string
}

const { username = "HonoraryMars605", class: className = "" } = Astro.props
const token = import.meta.env.GITHUB_TOKEN

function timeAgo(dateString: string) {
  const date = new Date(dateString)
  const now = new Date()
  const seconds = Math.floor((now.getTime() - date.getTime()) / 1000)

  if (seconds < 60) return 'poco fa'
  const minutes = Math.floor(seconds / 60)
  if (minutes < 60) return minutes + ' min fa'
  const hours = Math.floor(minutes / 60)
  if (hours < 24) return hours + ' ore fa'
  const days = Math.floor(hours / 24)
  if (days === 1) return 'ieri'
  if (days < 30) return days + ' giorni fa'
  return date.toLocaleDateString('it-IT', { day: 'numeric', month: 'short' })
}

function formatSize(sizeInKb: number) {
  if (!sizeInKb || sizeInKb === 0) return '0 KB'
  if (sizeInKb > 1024) {
    return (sizeInKb / 1024).toFixed(1) + ' MB'
  }
  return sizeInKb + ' KB'
}

let repos: any[] = []

try {
  const headers: Record<string, string> = {
    "Accept": "application/vnd.github.v3+json",
    "User-Agent": "Astro-Portfolio-App"
  }

  if (token) {
    headers["Authorization"] = `Bearer ${token}`
  }

  const endpoint = token
    ? `https://api.github.com/user/repos?sort=updated&per_page=6`
    : `https://api.github.com/users/${username}/repos?sort=updated&per_page=6`
  const response = await fetch(endpoint, { headers })

  if (response.ok) {
    const data = await response.json()
    if (Array.isArray(data)) {
      const filteredRepos = data.filter((repo: any) => !repo.fork && repo.private === false).slice(0, 6)

      repos = await Promise.all(
        filteredRepos.map(async (repo) => {
          let languages: string[] = []
          let contributors: any[] = []

          try {
            const langRes = await fetch(repo.languages_url, { headers })
            if (langRes.ok) {
              const langData = await langRes.json()
              languages = Object.keys(langData)
            }

            const contribRes = await fetch(repo.contributors_url, { headers })
            if (contribRes.ok) {
              contributors = await contribRes.json()
            }
          } catch (err) {
            console.error(`Errore nel fetch dettagli per ${repo.name}:`, err)
          }

          return {
            ...repo,
            allLanguages: languages,
            contributorsList: contributors
          }
        })
      )
    }
  } else {
    console.error("Errore API GitHub:", response.status, await response.text())
  }
} catch (e) {
  console.error("Errore di connessione a GitHub:", e)
}
---

<div class:list={["github-live-container", className]} id="github">
  <div class="repos-grid">
    {repos.length > 0 ? (
      repos.map((repo) => (
        <div class="repo-card">
          <div class="repo-head">
            <Link href={repo.html_url} external class="repo-name">
              {repo.name}
            </Link>
            <div class="repo-badges">
              <span class={`repo-visibility ${repo.private ? 'private' : 'public'}`}>
                {repo.private ? 'Privato' : 'Pubblico'}
              </span>
            </div>
          </div>

          {repo.allLanguages && repo.allLanguages.length > 0 && (
            <div class="repo-langs-row">
              {repo.allLanguages.map((lang: string) => (
                <span class="repo-tag">{lang}</span>
              ))}
            </div>
          )}

          {repo.description ? (
            <p class="repo-desc">{repo.description}</p>
          ) : (
            <p class="repo-desc repo-desc-empty">Nessuna descrizione disponibile.</p>
          )}

          <div class="repo-stats-row">
            <span title="Stelle">★ {repo.stargazers_count || 0}</span>
            <span title="Fork">⑂ {repo.forks_count || 0}</span>
            <span title="Dimensioni">📦 {formatSize(repo.size)}</span>
          </div>

          {repo.contributorsList && repo.contributorsList.length > 0 && (
            <div class="repo-contributors">
              <span class="contrib-label">Developer</span>
              <div class="contrib-avatars">
                {repo.contributorsList.map((c: any) => (
                  <a href={c.html_url} target="_blank" rel="noopener noreferrer" title={`Developer: ${c.login}`}>
                    <img src={c.avatar_url} alt={c.login} class="contrib-avatar" />
                  </a>
                ))}
              </div>
            </div>
          )}

          <div class="repo-footer">
            <span class="repo-updated">Aggiornato: {timeAgo(repo.updated_at)}</span>
          </div>
        </div>
      ))
    ) : (
      <div class="repo-card-fallback text-center py-4 text-zinc-400 text-sm col-span-full">
        Impossibile caricare i repository pubblici da GitHub al momento.
      </div>
    )}
  </div>
</div>

<style>
  .github-live-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    inline-size: 100%;
  }

  .repos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-s);
  }

  .repo-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: var(--space-s);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: border-color var(--motion-duration) var(--motion-ease), box-shadow var(--motion-duration) var(--motion-ease);
  }

  .repo-card:hover {
    border-color: color-mix(in srgb, var(--primary) 50%, var(--border));
    box-shadow: 0 4px 16px -4px color-mix(in srgb, var(--primary) 12%, transparent);
  }

  .repo-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-2xs);
  }

  .repo-name {
    font-weight: var(--font-weight-bold);
    font-size: var(--step-0);
    color: var(--foreground);
    text-decoration: none;
    word-break: break-all;
  }

  .repo-name:hover {
    color: var(--primary);
  }

  .repo-badges {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .repo-visibility {
    font-size: 0.65rem;
    font-weight: var(--font-weight-medium);
    padding: 0.1rem 0.35rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    color: var(--muted-foreground);
    background: var(--surface-2, transparent);
  }

  .repo-langs-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .repo-tag {
    background: var(--accent-soft);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    color: var(--accent);
    font-size: 0.65rem;
    font-weight: var(--font-weight-medium);
    padding: 0.1rem 0.35rem;
    border-radius: var(--radius-sm);
  }

  .repo-desc {
    margin: 0;
    font-size: var(--step--1);
    color: var(--muted-foreground);
    line-height: 1.4;
  }

  .repo-desc-empty {
    font-style: italic;
    opacity: 0.6;
  }

  .repo-stats-row {
    display: flex;
    gap: 0.75rem;
    font-size: 0.75rem;
    color: var(--muted-foreground);
    background: color-mix(in srgb, var(--surface) 80%, var(--border));
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
  }

  .repo-contributors {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--muted-foreground);
    background: color-mix(in srgb, var(--surface) 90%, var(--border));
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
  }

  .contrib-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.8;
  }

  .contrib-avatars {
    display: flex;
    align-items: center;
  }

  .contrib-avatar {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px solid var(--surface);
    object-fit: cover;
    margin-inline-start: -6px;
    transition: transform 0.2s ease, z-index 0.2s ease;
  }

  .contrib-avatars a:first-child .contrib-avatar {
    margin-inline-start: 0;
  }

  .contrib-avatar:hover {
    transform: scale(1.25);
    z-index: 10;
  }

  .repo-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    font-size: 0.75rem;
    color: var(--muted-foreground);
    margin-block-start: auto;
    border-block-start: 1px solid var(--border);
    padding-block-start: 0.4rem;
  }
</style>