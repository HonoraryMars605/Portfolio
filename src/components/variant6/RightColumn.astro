---
---

<main class="w-full lg:w-[820px] flex flex-col gap-[36px]">
  <!-- Sezione Esperienze Lavorative & Professionali -->
  <section class="flex flex-col">
    <!-- Intestazione con underline rosso -->
    <h2 class="font-heading text-2xl lg:text-[24px] text-black m-0">
      Esperienze Lavorative &amp; Professionali
    </h2>
    <div class="w-[120px] h-[4px] bg-[#8B1E2D] rounded-[2px] mt-1.5 mb-5"></div>

    <!-- Lista Esperienze -->
    <div class="flex flex-col gap-[20px]">
      <!-- 1. Skill Factory -->
      <div class="flex flex-col gap-[4px]">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <div class="flex items-baseline gap-1.5">
            <span class="font-bold text-[15px] text-black">Skill Factory</span>
            <span class="text-[13.5px] font-medium text-[#8B1E2D]">(Somministrazione)</span>
          </div>
          <div class="flex items-baseline gap-1.5">
            <span class="text-[13px] font-bold text-[#8B1E2D]">Back-end Developer</span>
            <span class="text-[#4B5563] text-[12px]">· Luglio 2026</span>
          </div>
        </div>
        <p class="text-[13px] text-[#111827] leading-relaxed m-0 pl-1">
          • Sviluppo piattaforma web focalizzato sul Back-end tramite Java/Spring Boot + Thymeleaf
        </p>
      </div>

      <!-- 2. L'ABCD Edutainment -->
      <div class="flex flex-col gap-[4px]">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <div class="flex items-baseline gap-1.5">
            <span class="font-bold text-[15px] text-black">L'ABCD Edutainment</span>
            <span class="text-[13.5px] font-medium text-[#8B1E2D]">(Tirocinio extracurriculare)</span>
          </div>
          <div class="flex items-baseline gap-1.5">
            <span class="text-[13px] font-bold text-[#8B1E2D]">Unity Developer</span>
            <span class="text-[#4B5563] text-[12px]">· Gennaio - Aprile 2026</span>
          </div>
        </div>
        <ul class="list-none p-0 m-0 flex flex-col gap-[2px] text-[13px] text-[#111827] leading-relaxed pl-1">
          <li>• Collaborazione alla ricerca e sviluppo di progetti orientati alla didattica per la piattaforma (MR- Mixed Reality) zSpace e MR-HMI (Human-Machine Interface)</li>
          <li>• Sviluppo in C# dei sistemi e 'wrapper' multi SDK.</li>
          <li>• Concept (Figma-Canva) e implementazione UI &amp; UX (uGUI).</li>
        </ul>
      </div>

      <!-- 3. Protom -->
      <div class="flex flex-col gap-[4px]">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <div class="flex items-baseline gap-1.5">
            <span class="font-bold text-[15px] text-black">Protom</span>
            <span class="text-[13.5px] font-medium text-[#8B1E2D]">(Somministrazione)</span>
          </div>
          <div class="flex items-baseline gap-1.5">
            <span class="text-[13px] font-bold text-[#8B1E2D]">Front-end Developer</span>
            <span class="text-[#4B5563] text-[12px]">· Novembre 2025</span>
          </div>
        </div>
        <p class="text-[13px] text-[#111827] leading-relaxed m-0 pl-1">
          • Co-sviluppo piattaforma web focalizzato sul Front-end tramite HTML5, CSS3 e JavaScript.
        </p>
      </div>

      <!-- 4. Katabasi Studio -->
      <div class="flex flex-col gap-[4px]">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <div class="flex items-baseline gap-1.5">
            <span class="font-bold text-[15px] text-black">Katabasi Studio</span>
            <span class="text-[13.5px] font-medium text-[#8B1E2D]">(Tirocinio curriculare)</span>
          </div>
          <div class="flex items-baseline gap-1.5">
            <span class="text-[13px] font-bold text-[#8B1E2D]">Unity Developer</span>
            <span class="text-[#4B5563] text-[12px]">· Novembre 2024 - Aprile 2025</span>
          </div>
        </div>
        <ul class="list-none p-0 m-0 flex flex-col gap-[2px] text-[13px] text-[#111827] leading-relaxed pl-1">
          <li>• Sviluppo di due prodotti B2B in Unity implementati su piattaforma WebGL.</li>
          <li>• Sviluppato in C#, integrati elementi UI (uGUI), organizzazione e documentazione tramite Milanote e Notion, gestione della localizzazione e Custom Editor Tools per l'ottimizzazione del workflow di sviluppo.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Griglia a due sotto-colonne: (Istruzione + Attestati) e (Specializzazioni + Progetti) -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-[40px] pt-1">
    <!-- Sotto-colonna Sinistra: Istruzione & Attestati -->
    <div class="flex flex-col gap-[28px]">
      <!-- Istruzione & Alta Formazione -->
      <section class="flex flex-col">
        <h2 class="font-heading text-xl lg:text-[24px] text-black m-0">
          Istruzione &amp; Alta Formazione
        </h2>
        <div class="w-[120px] h-[4px] bg-[#8B1E2D] rounded-[2px] mt-1.5 mb-5"></div>

        <div class="flex flex-col gap-[18px]">
          <!-- 42 Roma ELIS -->
          <div class="flex flex-col gap-[3px]">
            <h3 class="font-bold text-[14px] text-black m-0">42 Roma ELIS (in corso)</h3>
            <span class="text-[12.5px] font-medium text-[#8B1E2D]">Software Engineering - RNCP Livello 6 / EQF 6</span>
            <span class="text-[12px] text-[#4B5563]">Roma, Italia (Presenziale)</span>
            <span class="text-[12px] text-[#4B5563]">Piscine C: Ott-Nov 2026 · Common Core: Mar 2027</span>
          </div>

          <!-- ITS Lazio Digital -->
          <div class="flex flex-col gap-[3px]">
            <h3 class="font-bold text-[14px] text-black m-0">ITS Lazio Digital</h3>
            <span class="text-[12.5px] font-medium text-[#8B1E2D]">Tecnico Superiore Augmented, Virtual e Mixed Reality - EQF5</span>
            <span class="text-[12px] text-[#4B5563]">Roma, Italia (Presenziale) · 1.080 ore</span>
            <span class="text-[12px] font-semibold text-black">Votazione: 101/110</span>
          </div>

          <!-- ITIS Alessandro Volta -->
          <div class="flex flex-col gap-[3px]">
            <h3 class="font-bold text-[14px] text-black m-0">ITIS Alessandro Volta</h3>
            <span class="text-[12.5px] font-medium text-[#8B1E2D]">Diploma Tecnico in Informatica e Telecomunicazioni - EQF4</span>
            <span class="text-[12px] text-[#4B5563]">Napoli, Italia (Presenziale)</span>
            <span class="text-[12px] font-semibold text-black">Votazione: 100/100</span>
          </div>
        </div>
      </section>

      <!-- Attestati -->
      <section class="flex flex-col">
        <h2 class="font-heading text-xl lg:text-[24px] text-black m-0">
          Attestati
        </h2>
        <div class="w-[120px] h-[4px] bg-[#8B1E2D] rounded-[2px] mt-1.5 mb-5"></div>

        <div class="flex flex-wrap items-center gap-[10px]">
          <span class="px-3 py-1.5 bg-[#F3F4F6] border border-[#D1D5DB] rounded-[6px] text-[12.5px] text-[#111827] font-medium shadow-2xs">
            Epass
          </span>
          <span class="px-3 py-1.5 bg-[#F3F4F6] border border-[#D1D5DB] rounded-[6px] text-[12.5px] text-[#111827] font-medium shadow-2xs">
            Cisco Networking
          </span>
          <span class="px-3 py-1.5 bg-[#F3F4F6] border border-[#D1D5DB] rounded-[6px] text-[12.5px] text-[#111827] font-medium shadow-2xs">
            Gaming Week
          </span>
        </div>
      </section>
    </div>

    <!-- Sotto-colonna Destra: Specializzazioni & Progetti -->
    <div class="flex flex-col gap-[28px]">
      <!-- Specializzazioni -->
      <section class="flex flex-col">
        <h2 class="font-heading text-xl lg:text-[24px] text-black m-0">
          Specializzazioni
        </h2>
        <div class="w-[120px] h-[4px] bg-[#8B1E2D] rounded-[2px] mt-1.5 mb-5"></div>

        <div class="flex flex-col gap-[16px]">
          <!-- Skill Factory - Forma.Temp -->
          <div class="flex flex-col gap-[3px]">
            <h3 class="font-bold text-[14px] text-black m-0">Skill Factory - Forma.Temp</h3>
            <span class="text-[12.5px] font-medium text-[#8B1E2D]">Tecnico della programmazione</span>
            <span class="text-[12px] text-[#4B5563]">Apr - Giu 2026 · 240 ore</span>
          </div>

          <!-- Protom - Forma.Temp -->
          <div class="flex flex-col gap-[3px]">
            <h3 class="font-bold text-[14px] text-black m-0">Protom - Forma.Temp</h3>
            <span class="text-[12.5px] font-medium text-[#8B1E2D]">Full Stack Developer</span>
            <span class="text-[12px] text-[#4B5563]">Set - Ott 2025 · 160 ore</span>
          </div>

          <!-- ISAS Videogames Academy -->
          <div class="flex flex-col gap-[3px]">
            <h3 class="font-bold text-[14px] text-black m-0">ISAS Videogames Academy</h3>
            <span class="text-[12.5px] font-medium text-[#8B1E2D]">Game Design &amp; Game Development</span>
            <span class="text-[12px] text-[#4B5563]">Ott 2022 - Set 2023 · 475 ore</span>
          </div>
        </div>
      </section>

      <!-- Progetti -->
      <section class="flex flex-col">
        <h2 class="font-heading text-xl lg:text-[24px] text-black m-0">
          Progetti
        </h2>
        <div class="w-[120px] h-[4px] bg-[#8B1E2D] rounded-[2px] mt-1.5 mb-5"></div>

        <div class="flex flex-col gap-[14px]">
          <!-- Violinum -->
          <a href="/projects/violinum" class="flex flex-col gap-[2px] group no-underline">
            <h3 class="font-bold text-[14px] text-black group-hover:text-[#8B1E2D] transition-colors m-0">
              Violinum →
            </h3>
            <span class="text-[12px] font-medium text-[#8B1E2D]">Unity Developer (C#)</span>
            <span class="text-[11.5px] text-[#4B5563]">Ottobre 2024 - Maggio 2025</span>
          </a>

          <!-- Lock Fight -->
          <a href="/projects/lock-fight" class="flex flex-col gap-[2px] group no-underline">
            <h3 class="font-bold text-[14px] text-black group-hover:text-[#8B1E2D] transition-colors m-0">
              Lock Fight →
            </h3>
            <span class="text-[12px] font-medium text-[#8B1E2D]">Unity Developer (C#)</span>
            <span class="text-[11.5px] text-[#4B5563]">Settembre 2024 - Ottobre 2024</span>
          </a>

          <!-- Rusheep -->
          <a href="/projects/rusheep" class="flex flex-col gap-[2px] group no-underline">
            <h3 class="font-bold text-[14px] text-black group-hover:text-[#8B1E2D] transition-colors m-0">
              Rusheep →
            </h3>
            <span class="text-[12px] font-medium text-[#8B1E2D]">Unity Developer (C#)</span>
            <span class="text-[11.5px] text-[#4B5563]">Agosto 2024</span>
          </a>

          <!-- Sfuryatell -->
          <a href="/projects/sfuryatell" class="flex flex-col gap-[2px] group no-underline">
            <h3 class="font-bold text-[14px] text-black group-hover:text-[#8B1E2D] transition-colors m-0">
              Sfuryatell →
            </h3>
            <span class="text-[12px] font-medium text-[#8B1E2D]">UI/UX Unity Developer (C#) · UI Toolkit</span>
            <span class="text-[11.5px] text-[#4B5563]">Gennaio - Settembre 2023</span>
          </a>
        </div>
      </section>
    </div>
  </div>
</main>
