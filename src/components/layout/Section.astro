---
import Link from "@/components/base/Link.astro"

interface Props {
  title: string
  id?: string
  class?: string
  spacing?: "default" | "none"
  moreLink?: string
  moreText?: string
}

const {
  id,
  class: className,
  title,
  spacing = "default",
  moreLink,
  moreText = "see all →",
} = Astro.props

const sectionId = id || title.toLowerCase().replace(/[^a-z0-9]+/g, '-')
---

<section id={sectionId} class:list={["section-block", className]} data-spacing={spacing}>
  <section-heading>
    <h2>{title}</h2>
    {moreLink && (
      <Link href={moreLink} underline class="section-more">
        {moreText}
      </Link>
    )}
  </section-heading>
  <slot />
</section>

<style>
  .section-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    margin-block-start: var(--space-l);
    scroll-margin-top: 5rem;
  }

  .section-block[data-spacing="none"] {
    margin-block-start: 0;
  }

  section-heading {
    display: flex;
    align-items: baseline;
    gap: var(--space-s);
    min-width: 0;
  }

  h2 {
    position: relative;
    width: fit-content;
    margin: 0;
    padding-block-end: 0.25rem;
    color: var(--foreground);
    font-family: var(--font-heading);
    font-size: var(--step-2);
    line-height: 1.333;
    letter-spacing: var(--tracking-tight);
  }

  h2::after {
    content: "";
    position: absolute;
    inset-block-end: 0;
    inset-inline-start: 0;
    inline-size: 2.5rem;
    block-size: 3px;
    border-radius: 2px;
    background: var(--primary);
    opacity: 0.9;
    transition: inline-size 300ms ease-in-out;
  }

  .section-block:hover h2::after,
  section-heading:focus-within h2::after {
    inline-size: 3.75rem;
  }

  .section-more {
    flex-shrink: 0;
    color: var(--muted-foreground);
    font-size: var(--step-0);
    line-height: 1.5;
  }

  @media (width < 40rem) {
    .section-block {
      margin-block-start: var(--space-m);
    }

    section-heading {
      gap: var(--space-xs);
    }

    .section-more {
      font-size: var(--step--1);
    }
  }
</style>
