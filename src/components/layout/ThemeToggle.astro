---
import Button from "@/components/base/Button.astro"
import Icon from "@/components/base/Icon.astro"
---

<Button
  id="theme-toggle-btn"
  variant="ghost"
  size="square"
  title="Cambia tema (Light/Dark)"
  aria-label="Cambia tema (Light/Dark)"
  class="theme-toggle-btn"
>
  <div class="theme-icon-stack" aria-hidden="true">
    <Icon name="mingcute:sun-line" size="1.4rem" class="theme-icon-light" />
    <Icon name="mingcute:moon-line" size="1.4rem" class="theme-icon-dark" />
  </div>
</Button>

<style>
  .theme-icon-stack {
    display: grid;
    place-items: center;
  }
  .theme-icon-light,
  .theme-icon-dark {
    grid-area: 1 / 1;
    transition: transform var(--motion-duration) var(--motion-ease), opacity var(--motion-duration) var(--motion-ease);
  }
  .theme-icon-dark {
    opacity: 0;
    transform: scale(0.6) rotate(-45deg);
  }
  :global([data-theme="dark"]) .theme-icon-light {
    opacity: 0;
    transform: scale(0.6) rotate(-45deg);
  }
  :global([data-theme="dark"]) .theme-icon-dark {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }
</style>

<script is:inline>
  function setupThemeToggle() {
    const btn = document.getElementById("theme-toggle-btn")
    if (!btn) return

    btn.onclick = () => {
      const current = document.documentElement.getAttribute("data-theme") || "light"
      const next = current === "dark" ? "light" : "dark"
      document.documentElement.setAttribute("data-theme", next)
      document.documentElement.classList.remove("scheme-light", "scheme-dark")
      document.documentElement.classList.add(next === "dark" ? "scheme-dark" : "scheme-light")
      localStorage.setItem("theme", next)
    }
  }

  (() => {
    const stored = localStorage?.getItem("theme")
    const isDark = stored === "dark" || (!stored && window.matchMedia("(prefers-color-scheme: dark)").matches)
    const resolved = isDark ? "dark" : "light"
    document.documentElement.setAttribute("data-theme", resolved)
    document.documentElement.classList.add(resolved === "dark" ? "scheme-dark" : "scheme-light")
  })()

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupThemeToggle, { once: true })
  } else {
    setupThemeToggle()
  }
  document.addEventListener("astro:page-load", setupThemeToggle)
</script>
