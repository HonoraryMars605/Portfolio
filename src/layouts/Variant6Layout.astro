---
import "@/styles/global.css"

interface Props {
  title?: string
  description?: string
}

const {
  title = "Valerio Comella - CV Resume Pure",
  description = "Curriculum Vitae e Portfolio di Valerio Comella - Software Engineer, Unity (C#) & Full Stack Developer.",
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://valeriocomella.github.io")
---

<!doctype html>
<html lang="it" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Google Fonts: Alfa Slab One & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <style is:global>
      body {
        background-color: #ffffff;
        color: #111827;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        margin: 0;
        padding: 0;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      .font-heading {
        font-family: 'Alfa Slab One', cursive, system-ui, sans-serif;
        font-weight: 400;
      }
    </style>
  </head>
  <body class="bg-white text-[#111827] antialiased flex flex-col min-h-screen">
    <slot />
  </body>
</html>
