---
import "@/styles/global.css"
import SoundManager from "@/components/variant7/SoundManager.astro"
import Preloader from "@/components/variant7/Preloader.astro"
import CursorTrail from "@/components/variant7/CursorTrail.astro"
import TopNavbar from "@/components/variant7/TopNavbar.astro"
import FloatingNavRail from "@/components/variant7/FloatingNavRail.astro"
import PdfViewerModal from "@/components/variant7/PdfViewerModal.astro"

interface Props {
  title?: string
  description?: string
  bare?: boolean
}

const {
  title = "Valerio Comella - Swiss Editorial Portfolio",
  description = "Swiss Editorial Portfolio di Valerio Comella - Software Engineer | Unity (C#) & Full Stack Developer. Navigazione a scorrimento orizzontale, coordinate telemetry e sound design.",
  bare = false,
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://valeriocomella.github.io")
---

<!doctype html>
<html lang="it" class="h-full overflow-hidden select-none-subtle">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Google Fonts: Alfa Slab One, Inter & Fira Code (Swiss Editorial Precision) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Fira+Code:wght@400;500;600&family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Prevent Dark Mode Flicker / Hydrate Theme before paint -->
    <script is:inline>
      (function () {
        try {
          const savedTheme = localStorage.getItem("theme")
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches
          if (savedTheme === "dark" || (!savedTheme && prefersDark)) {
            document.documentElement.classList.add("dark")
            document.documentElement.setAttribute("data-theme", "dark")
          } else {
            document.documentElement.classList.remove("dark")
            document.documentElement.setAttribute("data-theme", "light")
          }
        } catch (e) {}
      })()
    </script>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <style is:global>
      :root {
        --color-editorial-bg: #FAF9F5;
        --color-editorial-accent: #9B1C2E;
        --color-editorial-dark: #111111;
        --color-editorial-text: #111827;
      }

      /* Responsive Typography & Layout Scaling for High-DPI and 4K Displays */
      @media (min-width: 1920px) {
        :root {
          font-size: 17px;
        }
      }
      @media (min-width: 2560px) {
        :root {
          font-size: 19.5px;
        }
      }
      @media (min-width: 3840px) {
        :root {
          font-size: 23px;
        }
      }

      html.dark,
      html[data-theme="dark"] {
        --color-editorial-bg: #0C1017;
        --color-editorial-accent: #B91C1C;
        --color-editorial-dark: #FFFFFF;
        --color-editorial-text: #F3F4F6;
        color-scheme: dark;
      }

      html, body {
        background-color: var(--color-editorial-bg);
        color: var(--color-editorial-text);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        margin: 0;
        padding: 0;
        height: 100%;
        width: 100%;
        overflow: hidden;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        transition: background-color 0.25s ease, color 0.25s ease;
      }

      .font-heading {
        font-family: 'Alfa Slab One', cursive, system-ui, sans-serif;
        font-weight: 400;
      }

      /* Custom Subtle Scrollbar for Horizontal Slider & Slides */
      #horizontal-slider-container::-webkit-scrollbar {
        height: 5px;
      }
      #horizontal-slider-container::-webkit-scrollbar-track {
        background: #F1EFEA;
      }
      html.dark #horizontal-slider-container::-webkit-scrollbar-track {
        background: #111827;
      }
      #horizontal-slider-container::-webkit-scrollbar-thumb {
        background: #D1D5DB;
        border-radius: 3px;
      }
      html.dark #horizontal-slider-container::-webkit-scrollbar-thumb {
        background: #374151;
      }
      #horizontal-slider-container::-webkit-scrollbar-thumb:hover {
        background: var(--color-editorial-accent);
      }

      .section-slide::-webkit-scrollbar {
        width: 6px;
      }
      .section-slide::-webkit-scrollbar-track {
        background: transparent;
      }
      .section-slide::-webkit-scrollbar-thumb {
        background: #D1D5DB;
        border-radius: 3px;
      }
      html.dark .section-slide::-webkit-scrollbar-thumb {
        background: #374151;
      }
      .section-slide::-webkit-scrollbar-thumb:hover {
        background: #9B1C2E;
      }

      /* Subtle noise/grid background overlay for Swiss aesthetic */
      .swiss-grid-overlay {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 1;
        background-image: radial-gradient(rgba(0, 0, 0, 0.04) 1px, transparent 1px);
        background-size: 24px 24px;
        opacity: 0.6;
        transition: opacity 0.25s ease;
      }

      html.dark .swiss-grid-overlay {
        background-image: radial-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px);
        opacity: 0.4;
      }
    </style>
  </head>
  <body class="bg-swiss-bg dark:bg-swiss-bg-dark text-[#111827] dark:text-[#F3F4F6] antialiased h-full w-full flex flex-col relative overflow-hidden transition-colors duration-200">
    {bare ? (
      <slot />
    ) : (
      <>
        <!-- Grid overlay texture -->
        <div class="swiss-grid-overlay"></div>

        <!-- Procedural Web Audio Sound Engine -->
        <SoundManager />

        <!-- Fictional Developer Preloader Splash (Portfolio · PC · 1920 Inspiration) -->
        <Preloader />

        <!-- Interactive Cursor Telemetry Trail (x, y coords & hex tokens) -->
        <CursorTrail />

        <!-- Fixed Top Editorial Navigation Bar -->
        <TopNavbar />

        <!-- Fixed Floating Right Navigation Rail -->
        <FloatingNavRail />

        <!-- PDF Viewer Modal (Visualizza PDF) -->
        <PdfViewerModal />

        <!-- Horizontal Scroll Sections Container -->
        <main
          id="horizontal-slider-container"
          class="relative z-10 h-screen w-full overflow-x-auto overflow-y-hidden flex flex-row flex-nowrap snap-x snap-mandatory scroll-smooth"
          tabindex="0"
          aria-label="Portfolio Swiss Editorial Orizzontale"
        >
          <slot />
        </main>

        <!-- Horizontal Wheel & Keyboard Translation Script -->
        <script>
          function setupHorizontalScroll() {
            const container = document.getElementById("horizontal-slider-container")
            if (!container) return

            container.addEventListener(
              "wheel",
              (e: WheelEvent) => {
                const target = e.target as HTMLElement
                let el: HTMLElement | null = target
                while (el && el !== container) {
                  const overflowY = window.getComputedStyle(el).overflowY
                  if ((overflowY === "auto" || overflowY === "scroll") && el.scrollHeight > el.clientHeight) {
                    const atTop = el.scrollTop <= 1 && e.deltaY < 0
                    const atBottom = el.scrollTop + el.clientHeight >= el.scrollHeight - 2 && e.deltaY > 0
                    if (!atTop && !atBottom) return
                  }
                  el = el.parentElement
                }

                if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
                  e.preventDefault()
                  container.scrollBy({
                    left: e.deltaY * 1.5,
                    behavior: "auto",
                  })
                }
              },
              { passive: false }
            )

            window.addEventListener("keydown", (e: KeyboardEvent) => {
              const modal = document.getElementById("pdf-modal-container")
              if (modal && !modal.classList.contains("hidden")) return

              if (e.key === "ArrowRight" || e.key === "PageDown") {
                e.preventDefault()
                container.scrollBy({ left: window.innerWidth * 0.85, behavior: "smooth" })
                if ((window as any).playSfx) (window as any).playSfx("slide")
              } else if (e.key === "ArrowLeft" || e.key === "PageUp") {
                e.preventDefault()
                container.scrollBy({ left: -window.innerWidth * 0.85, behavior: "smooth" })
                if ((window as any).playSfx) (window as any).playSfx("slide")
              }
            })
          }

          setupHorizontalScroll()
          document.addEventListener("astro:after-swap", setupHorizontalScroll)
        </script>
      </>
    )}
  </body>
</html>
